+if(OBS_ENABLE_RUST)
+  if(NOT DEFINED OBS_RUST_FFI_LIB)
+    message(FATAL_ERROR "OBS_ENABLE_RUST=ON requires OBS_RUST_FFI_LIB=/path/to/libobs_ffi.a (cargo build -p obs-ffi --release)")
