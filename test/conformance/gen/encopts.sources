-ljansson
# include paths are relative to test/conformance (run.sh must be started there), like the libcaption area
-Igen/encopts_inc
-I../../shared/opts-parser
-I../../deps/glad/include
-Wno-deprecated-declarations
-DENABLE_HEVC
-ffunction-sections
-fdata-sections
-Wl,--gc-sections
