# GPU timers (fake graphics): a gpu timer is created for every render pass only while GPU profiling is active.
# GPU profiling needs the profiler enabled; gpu_enable(true) before enable(true) is ignored (it ANDs with the pending state).
sp_source 0 0
sp_gpu 1
sp_enable 1
sp_frame_begin
sp_reset_video 60 1
sp_clock 1
sp_frame_begin
sp_render_begin
sp_gfx_cfg 2000 0 1000000000 1
sp_render 0 5 2000
sp_render_end
sp_tick 0 7
sp_frame_collect
sp_gfx
# gpu now requested properly
sp_gpu 1
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 2000
sp_render 0 6 3000
sp_render_end
sp_frame_collect
sp_gfx
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 4000
sp_render_end
sp_frame_collect
sp_result 0
sp_gfx
# ticks are converted to ns with the range frequency: 2 ticks at 1 kHz = 2000000 ns
sp_gfx_cfg 0 0 1000 1
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 2
sp_render_end
sp_frame_collect
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 2
sp_render_end
sp_frame_collect
sp_result 0
# disjoint ranges discard the samples and log a warning
sp_gfx_cfg 5000 1 1000000000 1
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 5000
sp_render_end
sp_frame_collect
sp_result 0
# timers whose data is not available are destroyed without a sample
sp_gfx_cfg 5000 0 1000000000 0
sp_frame_begin
sp_tick 0 7
sp_render_begin
sp_render 0 5 5000
sp_render_end
sp_frame_collect
sp_gfx
# disabling gpu releases the timer ranges at the end of the next collect
sp_gpu 0
sp_frame_begin
sp_frame_collect
sp_gfx
# disabling the profiler frees everything; results are gone
sp_enable 0
sp_frame_begin
sp_frame_collect
sp_result 0
sp_gfx
