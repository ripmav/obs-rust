# S-012 CORE: obs_hevc_keyframe and obs_parse_hevc_packet_priority for every NAL unit type.
# The NAL type is bits 6..1 of the first header byte ((b & 0x7f) >> 1); the second header byte
# (layer id / temporal id) is ignored. The first NAL with type <= 23 decides keyframe-ness:
# type >= 16 (BLA/IDR/CRA/reserved IRAP 22,23) -> true, otherwise false. Types 24..63 are skipped.
# Priority per NAL: IRAP 16..23 -> 3; TRAIL_R/TSA_R/STSA_R/RADL_R/RASL_R (1,3,5,7,9) -> 2;
# everything else (including TRAIL_N.., VCL_N10.., reserved, parameter sets, SEI) -> 0.
# Each line is one NAL: 000001 <type<<1> 01 aa bb
echo type-0-TRAIL_N
hevc_keyframe 0000010001aabb
hevc_priority 0000010001aabb
echo type-1-TRAIL_R
hevc_keyframe 0000010201aabb
hevc_priority 0000010201aabb
echo type-2-TSA_N
hevc_keyframe 0000010401aabb
hevc_priority 0000010401aabb
echo type-3-TSA_R
hevc_keyframe 0000010601aabb
hevc_priority 0000010601aabb
echo type-4-STSA_N
hevc_keyframe 0000010801aabb
hevc_priority 0000010801aabb
echo type-5-STSA_R
hevc_keyframe 0000010a01aabb
hevc_priority 0000010a01aabb
echo type-6-RADL_N
hevc_keyframe 0000010c01aabb
hevc_priority 0000010c01aabb
echo type-7-RADL_R
hevc_keyframe 0000010e01aabb
hevc_priority 0000010e01aabb
echo type-8-RASL_N
hevc_keyframe 0000011001aabb
hevc_priority 0000011001aabb
echo type-9-RASL_R
