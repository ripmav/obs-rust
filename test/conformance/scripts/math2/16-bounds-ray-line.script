# bounds_intersection_ray / _line / intersects_ray / intersects_line (S-009-R74, R75).
# t is in units of the direction vector (not normalised) for rays, fraction of p1->p2 for lines.
bounds b -1 -1 -1 1 1 1
vec3 o -5 0 0
vec3 dx 1 0 0
vec3 dx2 2 0 0
vec3 mdx -1 0 0
call h bounds_intersection_ray b o dx
call h bounds_intersection_ray b o dx2
call h bounds_intersection_ray b o mdx
# origin inside the box: t is the exit distance
vec3 in 0 0 0
call h bounds_intersection_ray b in dx
call h bounds_intersection_ray b in mdx
# origin behind a box that is behind: miss
vec3 beh 5 0 0
call h bounds_intersection_ray b beh dx
call h bounds_intersection_ray b beh mdx
# parallel to a slab and outside it
vec3 off 0 5 0
vec3 ox -5 5 0
call h bounds_intersection_ray b ox dx
vec3 ox2 -5 1 0
call h bounds_intersection_ray b ox2 dx
vec3 ox3 -5 1.0001 0
call h bounds_intersection_ray b ox3 dx
# diagonal ray through the corner region
vec3 od -5 -5 -5
vec3 dd 1 1 1
call h bounds_intersection_ray b od dd
vec3 dd2 1 0.5 0.25
vec3 od2 -3 -1 -0.5
call h bounds_intersection_ray b od2 dd2
# zero direction: no component has |f|>0, so only the slab-containment tests decide
vec3 zero 0 0 0
call h bounds_intersection_ray b in zero
call h bounds_intersection_ray b o zero
# line: p1 -> p2, t = fraction of the segment (can exceed 1: the segment is NOT clipped)
vec3 p1 -5 0 0
vec3 p2 5 0 0
vec3 p3 -3 0 0
call h bounds_intersection_line b p1 p2
call h bounds_intersection_line b p1 p3
call h bounds_intersection_line b p2 p1
vec3 shift 0 3 0
vec3 q1 -5 3 0
vec3 q2 5 3 0
call h bounds_intersection_line b q1 q2
# segment shorter than TINY_EPSILON (1e-5) is rejected
vec3 s1 0 0 0
vec3 s2 0.000005 0 0
vec3 s3 0.00002 0 0
call h bounds_intersection_line b s1 s2
call h bounds_intersection_line b s1 s3
call h bounds_intersection_line b s1 s1
# inline wrappers return only the boolean
call r bounds_intersects_ray b o dx
call r bounds_intersects_ray b o mdx
call r bounds_intersects_line b p1 p2
call r bounds_intersects_line b q1 q2
