# Service connect info: username / password / stream id / encrypt passphrase pass through verbatim (NULL stays NULL, empty
# stays empty); without a service the setup fails with code OBS_OUTPUT_ERROR before anything else is read.
create
world user alice
world pass s3cret
world streamid "live/stream key"
world passphrase "0123456789"
cfg
world user -
world pass ""
world streamid -
world passphrase -
cfg
world service off
cfg
