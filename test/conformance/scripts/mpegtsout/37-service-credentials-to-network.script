# The service's stream id / passphrase / username / password reach the network layer: SRT gets streamid and passphrase
# (empty strings are treated as unset; a value in the URL query overrides the service value); RIST gets secret, username and
# password (URL values win); the SRT packet size from the URL sets the socket payload size.
create
world streamid cam1
world passphrase "0123456789"
start
stop 0
world streamid ""
world passphrase ""
start
stop 0
world streamid cam1
world url "srt://192.0.2.10:9000?streamid=urlcam&pkt_size=1000"
start
pkt v 0 0 0 1 3000
pkt a 0 0 0 1 200
drain
stop 0
sends
world url "rist://192.0.2.20:8000"
world user alice
world pass s3cret
world passphrase "ristsecret1"
start
stop 0
world user ""
world pass ""
world passphrase -
start
stop 0
