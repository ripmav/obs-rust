# Lexical rules: what counts as a name, how whitespace and comments are skipped
# between tokens.
parse "void _f(int _a)"
parse "void f1(int a1b2)"
parse "void f(int a)\n"
parse "void f(/* c */int a)"
parse "void f(int /* c */ a)"
parse "void f(int a /* c */ , /* d */ int b)"
parse "void f(int a // line\n, int b)"
parse "void f(int\na)"
parse "void f/* c */(int a)"
parse "void /* c */ f(int a)"
parse "void\tf(int a)"
parse "void f (int a)"
parse "voidf(int a)"
parse "void f(inta)"
parse "void f(int  a,int b)"
parse "void f(in out int a)"
parse "void f(in/**/int a)"
parse "void f(ininta)"
parse "void f(int outa)"
parse "void f(out ptr p, in string s, bool b)"
parse "void f(int \xc3\xa9)"
parse "void \xc3\xa9()"
parse "void f(int a.b)"
parse "void f(int a_)"
parse "void f(int _)"
parse "void f(int __)"
parse "void f(int 0)"
