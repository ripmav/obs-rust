# Type and specifier keywords are case sensitive; names are free-form identifiers.
parse "void f(Int a)"
parse "void f(INT a)"
parse "void f(IN int a)"
parse "Void f()"
parse "void IN(int a)"
parse "void in(int a)"
parse "void out(int a)"
parse "void f(int in)"
parse "void f(int out)"
parse "void f(in int out)"
parse "void Return(int a)"
parse "void f(int Return)"
parse "int return_value()"
