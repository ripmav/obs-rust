# Valid declarations. A non-void return type adds a final OUT parameter "return".
parse "void source_create(ptr source)"
parse "void f()"
parse "void f( )"
parse "int get_count()"
parse "float ratio(in int a, in int b)"
parse "bool enabled(ptr source, out bool value)"
parse "string name(ptr source)"
parse "ptr find(string name, out ptr found)"
parse "void multi(int a, float b, bool c, ptr d, string e)"
parse "void inout(in out int both)"
parse "void outin(out in int both)"
parse "void outonly(out string text)"
parse "void under_score_1(int _x1, int X2)"
parse "void\nnewlines(\nint a,\nint b\n)"
parse "void tabs(\tint\ta)"
parse "void with_comment(int a /* inline */, int b) // trailing"
