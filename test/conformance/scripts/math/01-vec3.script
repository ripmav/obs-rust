# vec3 keeps a fourth lane w. add/sub/div zero it; mul and mulf multiply it like the other lanes.
vec3 a 1 2 3
vec3 b 4 5 6
vec3 w1 1 2 3 10
vec3 w2 1 1 1 10
call s vec3_add a b
call s2 vec3_sub b a
call s3 vec3_mul a b
call s4 vec3_div b a
call s5 vec3_addf a 0.5
call s6 vec3_mulf a 2
call s7 vec3_divf b 2
call s8 vec3_subf a 1
call d vec3_dot a b
call c vec3_cross a b
call n vec3_neg a
call l vec3_len a
call di vec3_dist a b
call no vec3_norm b
vec3 z 0 0 0
call nz vec3_norm z
call mn vec3_min a b
call mx vec3_max a b
call mnf vec3_minf b 5
call mxf vec3_maxf a 2
vec3 f -1.5 2.5 -0.2
call ab vec3_abs f
call fl vec3_floor f
call ce vec3_ceil f
