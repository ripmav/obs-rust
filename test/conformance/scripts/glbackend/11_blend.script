# Blending.  Destination is cleared to (0,0,1,1) (opaque blue) and a quad of colour
# (1,0,0,A) is drawn over pixels (1..2,1..2).  Only A in {0,1} is used so that every result is
# exact on any conforming driver.  Blend state is global GL state and persists between draws.
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
clear CLEAR_COLOR 0 0 0 1
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return o; }
end
pshader ps
uniform float4 color = {1.0, 0.0, 0.0, 1.0};
struct VI { float4 pos : POSITION; };
float4 main(VI v) : TARGET { return color; }
end
vb quad 6 0 0 0
1 1 0
1 3 0
3 1 0
3 1 0
1 3 0
3 3 0
end
load_vb quad
load_vs vs
load_ps ps
blend on
# disabled/enabled and function: src*SRCALPHA + dst*INVSRCALPHA with alpha 1 and alpha 0
blendfn BLEND_SRCALPHA BLEND_INVSRCALPHA
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 1
draw TRIS 0 6
read rt
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 0
draw TRIS 0 6
read rt
# ONE/ONE adds
blendfn BLEND_ONE BLEND_ONE
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 0
draw TRIS 0 6
read rt
# ZERO/ONE keeps destination, ONE/ZERO replaces
blendfn BLEND_ZERO BLEND_ONE
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 1
draw TRIS 0 6
read rt
blendfn BLEND_ONE BLEND_ZERO
draw TRIS 0 6
read rt
# separate colour / alpha factors: colour = src, alpha = dst
blendfn_sep BLEND_ONE BLEND_ZERO BLEND_ZERO BLEND_ONE
clear CLEAR_COLOR 0 0 1 0
set ps color vec4 1 0 0 1
draw TRIS 0 6
read rt
# operations with ONE/ONE: subtract (src - dst), reverse subtract (dst - src), min, max
blendfn BLEND_ONE BLEND_ONE
blendop BLEND_OP_SUBTRACT
clear CLEAR_COLOR 0 1 0 1
set ps color vec4 1 1 0 1
draw TRIS 0 6
read rt
blendop BLEND_OP_REVERSE_SUBTRACT
clear CLEAR_COLOR 0 1 0 1
draw TRIS 0 6
read rt
blendop BLEND_OP_MIN
clear CLEAR_COLOR 0 1 0 1
draw TRIS 0 6
read rt
blendop BLEND_OP_MAX
clear CLEAR_COLOR 0 1 0 1
draw TRIS 0 6
read rt
blendop BLEND_OP_ADD
# disabled blending replaces
blend off
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 0
draw TRIS 0 6
read rt
# DST colour factors
blend on
blendfn BLEND_DSTCOLOR BLEND_ZERO
clear CLEAR_COLOR 1 0 1 1
set ps color vec4 1 1 0 1
draw TRIS 0 6
read rt
blendfn BLEND_INVDSTCOLOR BLEND_ZERO
clear CLEAR_COLOR 1 0 1 1
set ps color vec4 1 1 0 1
draw TRIS 0 6
read rt
blendfn BLEND_SRCCOLOR BLEND_INVSRCCOLOR
clear CLEAR_COLOR 0 0 1 1
set ps color vec4 1 0 0 1
draw TRIS 0 6
read rt
destroy
