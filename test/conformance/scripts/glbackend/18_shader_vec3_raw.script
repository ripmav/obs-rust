# A float3 uniform can only be uploaded through gs_shader_set_val with exactly 12 bytes (see D-5
# in 17_shader_uniforms).  Single draw per script on purpose (see OQ-1 in the spec).
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
clear CLEAR_COLOR 0 0 0 1
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return o; }
end
vb quad 6 0 0 0
1 1 0
1 3 0
3 1 0
3 1 0
1 3 0
3 3 0
end
load_vb quad
load_vs vs
pshader p3
uniform float3 v3;
struct VI { float4 pos : POSITION; };
float4 main(VI v) : TARGET { return float4(v3.x, v3.y, v3.z, 1.0); }
end
load_ps p3
set p3 v3 raw 0000803f000000000000803f
draw TRIS 0 6
read rt
destroy
