# Stencil test with a Z24_S8 buffer.  The function reference value is fixed at 0 and the
# compare mask is all ones (device_stencil_function), so tests compare the stored stencil with
# 0; stored values are changed with INCR / INVERT / ZERO.
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
clear CLEAR_COLOR 0 0 0 1
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return o; }
end
pshader ps
uniform float4 color = {1.0, 0.0, 0.0, 1.0};
struct VI { float4 pos : POSITION; };
float4 main(VI v) : TARGET { return color; }
end
vb quad 6 0 0 0
1 1 0
1 3 0
3 1 0
3 1 0
1 3 0
3 3 0
end
load_vb quad
load_vs vs
load_ps ps
zs z 4 4 Z24_S8
set_rt rt z
stencil on
# pass 1: always pass, increment stored stencil
stencilfn STENCIL_BOTH ALWAYS
stencilop STENCIL_BOTH KEEP KEEP INCR
clear CLEAR_COLOR|CLEAR_STENCIL 0 0 0 1 1.0 0
set ps color vec4 1 0 0 1
draw TRIS 0 6
# pass 2: stencil == 0 required: only pixels outside the quad pass; draw a full-screen quad
vb full 6 0 0 0
0 0 0
0 4 0
4 0 0
4 0 0
0 4 0
4 4 0
end
load_vb full
stencilfn STENCIL_BOTH EQUAL
stencilop STENCIL_BOTH KEEP KEEP KEEP
set ps color vec4 0 1 0 1
draw TRIS 0 6
read rt
# NOTEQUAL: only the incremented pixels pass
clear CLEAR_COLOR 0 0 0 1
stencilfn STENCIL_BOTH NOTEQUAL
set ps color vec4 0 0 1 1
draw TRIS 0 6
read rt
# stencil write disabled (glStencilMask 0): INCR no longer changes the buffer, and ALSO the
# stencil clear is masked, so the values written above survive 'clear CLEAR_STENCIL' (Q-2).
stencil_write off
clear CLEAR_COLOR|CLEAR_STENCIL 0 0 0 1 1.0 0
stencilfn STENCIL_BOTH ALWAYS
stencilop STENCIL_BOTH KEEP KEEP INCR
draw TRIS 0 6
stencilfn STENCIL_BOTH NOTEQUAL
set ps color vec4 1 1 1 1
clear CLEAR_COLOR 0 0 0 1
draw TRIS 0 6
read rt
stencil_write on
# DECR/INVERT/ZERO/REPLACE: ZERO resets the stored value to 0
clear CLEAR_COLOR|CLEAR_STENCIL 0 0 0 1 1.0 0
stencilfn STENCIL_BOTH ALWAYS
stencilop STENCIL_BOTH KEEP KEEP INVERT
draw TRIS 0 6
stencilop STENCIL_BOTH KEEP KEEP ZERO
load_vb quad
draw TRIS 0 6
clear CLEAR_COLOR 0 0 0 1
stencilfn STENCIL_BOTH NOTEQUAL
load_vb full
draw TRIS 0 6
read rt
# stencil test off: everything passes
stencil off
clear CLEAR_COLOR 0 0 0 1
draw TRIS 0 6
read rt
destroy
