# DRIVER DEPENDENT vectors (values generated with Mesa llvmpipe; another conforming driver may
# differ in the last bit or in capability answers).  Not part of the normative expectations.
create
enter
avail
# linear filtering between a red and a green texel: exact midpoint rounds differently per driver
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
tex img 2 1 RGBA 1 0 ff0000ff00ff00ff
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; float2 uv : TEXCOORD0; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); o.uv = v.uv; return o; }
end
pshader ps
uniform texture2d image;
sampler_state samp { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
struct VI { float4 pos : POSITION; float2 uv : TEXCOORD0; };
float4 main(VI v) : TARGET { return image.Sample(samp, v.uv); }
end
vb full 6 0 0 1
0 0 0 0 0
0 4 0 0 1
4 0 0 1 0
4 0 0 1 0
0 4 0 0 1
4 4 0 1 1
end
load_vb full
load_vs vs
load_ps ps
sampler lin FILTER_LINEAR ADDRESS_CLAMP ADDRESS_CLAMP ADDRESS_CLAMP 1 0
set ps image tex img
set ps image sampler lin
clear CLEAR_COLOR 0 0 0 1
draw TRIS 0 6
read rt
destroy
