# Vertex attributes and index buffers.  Vertex colours are 32 bit values whose memory bytes are
# R,G,B,A (little-endian hex AABBGGRR in the script).  Texture coordinates are 2 floats.
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; float4 col : COLOR; float2 uv : TEXCOORD0; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); o.col = v.col; o.uv = v.uv; return o; }
end
pshader ps
struct VI { float4 pos : POSITION; float4 col : COLOR; float2 uv : TEXCOORD0; };
float4 main(VI v) : TARGET { return float4(v.col.r, v.uv.x, v.uv.y, v.col.a); }
end
load_vs vs
load_ps ps
# per-vertex colour (no interpolation visible: all vertices equal) and uv (0 or 1 at the corners)
vb cq 4 0 1 1
0 0 0 ff0000ff 0 0
4 0 0 ff0000ff 1 0
0 4 0 ff0000ff 0 1
4 4 0 ff0000ff 1 1
end
load_vb cq
clear CLEAR_COLOR 0 0 0 0
draw TRISTRIP 0 4
read rt
# index buffer, 16 bit: two triangles from 4 vertices; indices 0 1 2 | 2 1 3
ib i16 UNSIGNED_SHORT 0 1 2 2 1 3
load_ib i16
clear CLEAR_COLOR 0 0 0 0
draw TRIS 0 6
read rt
# start is an index offset: only the second triangle
clear CLEAR_COLOR 0 0 0 0
draw TRIS 3 3
read rt
# 32 bit indices, num 0 = all indices of the buffer
ib i32 UNSIGNED_LONG 0 1 2
load_ib i32
clear CLEAR_COLOR 0 0 0 0
draw TRIS 0 0
read rt
# detach the index buffer: back to array drawing.  Lines and points use interior coordinates
# so that no vertex sits on a pixel boundary (rasterisation rules for those are driver detail).
load_ib -
vb lp 4 0 1 1
0 2.5 0 ff0000ff 0 0
4 2.5 0 ff0000ff 0 0
1.5 0.5 0 ff0000ff 0 0
3.5 0.5 0 ff0000ff 0 0
end
load_vb lp
clear CLEAR_COLOR 0 0 0 0
draw LINES 0 2
read rt
clear CLEAR_COLOR 0 0 0 0
draw POINTS 2 2
read rt
# a vertex buffer lacking an input of the vertex shader: logged, drawing continues (the
# missing attribute reads as a GL default)
vb nouv 3 0 1 0
0 0 0 ff0000ff
4 0 0 ff0000ff
0 4 0 ff0000ff
end
load_vb nouv
clear CLEAR_COLOR 0 0 0 0
draw TRIS 0 3
read rt
destroy
