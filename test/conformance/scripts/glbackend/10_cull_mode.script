# Culling.  Winding is judged in the y-down space the caller draws in (ortho with top=0):
# triangle A is clockwise there and drawn red, triangle B is counter-clockwise and drawn green.
# GS_BACK (the device default) keeps counter-clockwise (front) faces, GS_FRONT keeps clockwise
# ones, GS_NEITHER keeps both.  The state is global and survives set_rt changes.
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
clear CLEAR_COLOR 0 0 0 1
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return o; }
end
pshader ps
uniform float4 color = {1.0, 0.0, 0.0, 1.0};
struct VI { float4 pos : POSITION; };
float4 main(VI v) : TARGET { return color; }
end
vb quad 6 0 0 0
1 1 0
1 3 0
3 1 0
3 1 0
1 3 0
3 3 0
end
load_vb quad
load_vs vs
load_ps ps
vb two 6 0 0 0
0 0 0
4 0 0
0 2 0
0 2 0
0 4 0
4 4 0
end
load_vb two
get_cull
# GS_BACK (the device default)
cull BACK
get_cull
clear CLEAR_COLOR 0 0 0 1
set ps color vec4 1 0 0 1
draw TRIS 0 3
set ps color vec4 0 1 0 1
draw TRIS 3 3
read rt
cull FRONT
get_cull
clear CLEAR_COLOR 0 0 0 1
set ps color vec4 1 0 0 1
draw TRIS 0 3
set ps color vec4 0 1 0 1
draw TRIS 3 3
read rt
cull NEITHER
get_cull
clear CLEAR_COLOR 0 0 0 1
set ps color vec4 1 0 0 1
draw TRIS 0 3
set ps color vec4 0 1 0 1
draw TRIS 3 3
read rt
destroy
