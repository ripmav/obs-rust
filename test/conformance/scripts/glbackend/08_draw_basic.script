# Basic drawing: solid colour quad (two triangles), uniform upload through gs_shader_set_*,
# view-projection (ortho) handling, view matrix from the matrix stack, projection push/pop,
# draw ranges, tri-strip, default shader uniform value, culling disabled in the prelude.
create
enter
tex rt 4 4 RGBA 1 RENDER_TARGET -
set_rt rt
viewport 0 0 4 4
ortho 0 4 0 4 -100 100
cull NEITHER
clear CLEAR_COLOR 0 0 0 1
vshader vs
uniform float4x4 ViewProj;
struct VI { float4 pos : POSITION; };
VI main(VI v) { VI o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return o; }
end
pshader ps
uniform float4 color = {1.0, 0.0, 0.0, 1.0};
struct VI { float4 pos : POSITION; };
float4 main(VI v) : TARGET { return color; }
end
vb quad 6 0 0 0
1 1 0
1 3 0
3 1 0
3 1 0
1 3 0
3 3 0
end
load_vb quad
load_vs vs
load_ps ps
# the default value from the shader text ({1,0,0,1}) is the initial value of 'color':
draw TRIS 0 6
read rt
clear CLEAR_COLOR 0 0 0 1
set ps color vec4 0 1 0 1
draw TRIS 0 6
read rt
# draw only the second triangle (start 3, 3 vertices)
clear CLEAR_COLOR 0 0 0 1
set ps color vec4 0 0 1 1
draw TRIS 3 3
read rt
# num_verts 0 means "all vertices of the buffer"
clear CLEAR_COLOR 0 0 0 1
draw TRIS 0 0
read rt
# set_default restores the value from the shader text
clear CLEAR_COLOR 0 0 0 1
set ps color default
draw TRIS 0 6
read rt
# a different projection: 8x8 units over 4 pixels halves everything
clear CLEAR_COLOR 0 0 0 1
ortho 0 8 0 8 -100 100
draw TRIS 0 6
read rt
# view matrix (matrix stack top) translates by (+2,0)
clear CLEAR_COLOR 0 0 0 1
ortho 0 4 0 4 -100 100
view_translate 2 0 0
draw TRIS 0 6
read rt
view_translate 0 0 0
# projection push/pop restores the previous projection
proj_push
ortho 0 8 0 8 -100 100
proj_pop
clear CLEAR_COLOR 0 0 0 1
draw TRIS 0 6
read rt
# extra pop with an empty stack is ignored
proj_pop
destroy
