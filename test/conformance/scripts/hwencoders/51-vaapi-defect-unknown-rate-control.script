# S-050 obs-ffmpeg-vaapi DEFECT D-3: vaapi_update() calls strcmp(rc_mode->name, "CBR") on the result
# of get_rc_mode(). For an unknown (or empty) rate_control the lookup returns the table sentinel whose
# name is NULL, and strcmp(NULL, ...) crashes the reference. Required behaviour: treat an unknown mode
# as the first table entry (CBR), which is what the code's own `rc_mode ? rc_mode : RC_MODES` fallback
# intended. Recorded in forked children.
va_defaults h264
set int bitrate 5000
set str rate_control bogus
fcall va_create h264
set str rate_control ""
fcall va_create h264
