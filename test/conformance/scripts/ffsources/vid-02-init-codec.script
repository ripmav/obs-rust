# ffmpeg_video_encoder_init_codec: opening the codec, error reporting, frame set-up.
av_codec fake_enc 1
host_video 1920 1080 NV12 709 partial 60 1
host_last_error @null
vid_init V fake_enc @null "Fake" 0 0
vid_update V 2500 2 @null
vid_init_codec V
vid_dump V
vid_free V
echo ---- HDR PQ full range 4:4:4 10-bit-class format: colour properties are copied to the frame
host_video 64 32 I444 pq full 30 1
vid_init V fake_enc @null "Fake" 0 0
vid_update V 5000 0 @null
vid_init_codec V
vid_free V
echo ---- open failure without callback: the error text is built from the locale template
host_video 64 32 NV12 709 partial 30 1
host_int open_rc -1000
vid_init V fake_enc @null "Fake" 0 0
vid_update V 5000 0 @null
vid_init_codec V
vid_dump V
vid_free V
echo ---- open failure with callback: callback receives the code, no error text is set
host_last_error @null
vid_init V fake_enc @null "Fake" 1 0
vid_update V 5000 0 @null
vid_init_codec V
vid_free V
echo ---- open failure when a last-error already exists: neither is called
host_last_error "earlier problem"
vid_init V fake_enc @null "Fake" 1 0
vid_update V 5000 0 @null
vid_init_codec V
show_last_error
vid_free V
host_int open_rc 0
host_last_error @null
echo ---- frame buffer allocation fails (zero size): returns false after the codec opened
host_video 0 0 NV12 709 partial 30 1
vid_init V fake_enc @null "Fake" 0 0
vid_update V 5000 0 @null
vid_init_codec V
vid_dump V
vid_free V
