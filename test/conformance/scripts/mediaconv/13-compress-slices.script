# start_y / end_y select the luma rows [start_y, end_y) processed two at a time. Both MUST be even
# (see spec: odd values are outside the contract). Chroma row index = y/2, luma row index = y.
# Input 4x4: row r has U=0x10*r+i, Y=0x20+4r+i, V=0x80+4r+i, X=0.  Output planes are pre-filled with ee.
# whole image
compress i420 0 4 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
# only rows 0-1
compress i420 0 2 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
# only rows 2-3 (writes luma rows 2,3 and chroma row 1)
compress i420 2 4 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
# empty range does nothing
compress i420 2 2 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
compress i420 4 4 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
# end beyond the last row pair is not allowed; start 0 end 0 writes nothing
compress i420 0 0 16 4 2 2 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
compress nv12 2 4 16 4 4 0 4 2 0 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
compress i444 2 4 16 4 4 4 4 4 4 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
# chroma strides 6 (planar) and 8 (NV12): chroma row y/2 starts at (y/2)*OUT_LS1
compress i420 0 4 16 4 6 6 4 2 2 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
compress nv12 0 4 16 4 8 0 4 2 0 00208000012181000222820003238300102484001125850012268600132787002028880021298900222a8a00232b8b00302c8c00312d8d00322e8e00332f8f00
