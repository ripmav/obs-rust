linesizes 99 5
# QUIRK Q-2: V210. The reference first "aligns" the width with the expression
#   a = (w + 47) & ~47        (32-bit, ~47 = 0xFFFFFFD0: bits 0-3 and bit 5 are cleared)
# which is NOT a round-up to a multiple of 48 (48 is not a power of two); then linesize = ((a+5)/6)*16.
# e.g. w=1 -> a=16 -> 48 ; w=48 -> a=80 -> 224 ; w=49 -> a=64 -> 176 (a real 49-pixel V210 row would need 256,
# so the result is too small) ; w=1920 -> a=1920 -> 5120. Implementations MUST reproduce the formula.
linesizes 24 0
linesizes 24 1
linesizes 24 6
linesizes 24 47
linesizes 24 48
linesizes 24 49
linesizes 24 96
linesizes 24 97
linesizes 24 1920
# width 0 gives zero linesizes for every format
linesizes 1 0
linesizes 2 0
linesizes 4 0
linesizes 10 0
linesizes 24 0
# large width, 32-bit arithmetic is used (no 64-bit widening): 0x40000000*4 wraps to 0
linesizes 6 0x40000000
linesizes 6 0x3fffffff
