# CORE: stinger audio: fade-out/fade-in vs cross-fade curves, media audio mixed on top, timestamp rules.
load quiet
create st obs_stinger_transition str:path=/m/s.mov int:transition_point=500 int:audio_fade_style=0
tick st
src media#1 dur_ns=1750000000 frames=100
start st
# transition point 0.25: a reaches 0 at t=0.25, b is 0 before t=0.25 (fade-in from the point)
mix st 0x1 2 48000 0 0.05 0.1 0.2 0.25 0.3 0.5 0.75 0.9 1
stop st
# cross fade
settings st int:audio_fade_style=1
tick st
src media#2 dur_ns=1750000000 frames=100
start st
mix st 0x1 2 48000 0 0.25 0.5 1
stop st
