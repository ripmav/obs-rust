# Reconnect: a DISCONNECTED stop code while retry_count > 0 ends data capture without a "stop" signal, emits
# "reconnect" (timeout in whole seconds) and, when the timer expires, restarts the output through the plugin
# start callback. A successful restart emits "reconnect_success" instead of "start".
# (The runner replaces the timer by an explicit `fire` command; poke_exp pins the reference's randomised
# exponent to 1.5.)
video 30 1 1280 720
audio 48000
venc v
aenc a
out o av,encoded autobegin=1
set_venc o v
set_aenc o a
reconnect_cfg o 3 2
poke_exp o 1.5
start o
echo --- connection lost
signal_stop o -5
state o
echo --- timer expires; the plugin restarts and begins capture again
fire
state o
info o
echo --- a normal stop afterwards behaves as usual
stop o
