# Same as dl_reconnect_preserve but without the PRESERVE flag: the active delay stays at the configured value
# while reconnecting.
video 30 1 1280 720
audio 48000
venc v
aenc a frame_size=1024
out o av,encoded autobegin=1
set_venc o v
set_aenc o a
set_delay o 2 0
reconnect_cfg o 3 1
poke_exp o 1.5
clock 0
start o
clock 2000000001
emit a 0 0 0 4
emit v 0 0 1 4
clock 2100000000
emit a 1024 1024 0 4
state o
echo --- connection drops (output has started: START was released); reconnect pending
signal_stop o -5
state o
echo --- packets still arrive from the encoders during the outage and the delay queue ages
clock 6000000000
emit a 2048 2048 0 4
state o
info o
echo --- reconnect attempt succeeds
fire
state o
