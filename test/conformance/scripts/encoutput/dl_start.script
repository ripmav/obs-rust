# Delay: with delay_sec > 0 the core begins capturing at once (activate, starting) but the plugin start callback
# only runs after the delay has elapsed. Delay processing is driven by arriving packets: a queued entry is
# released when (now - queued_at) > delay (strictly greater). Packets are held back by the same rule.
video 30 1 1280 720
audio 48000
venc v
aenc a frame_size=1024
out o av,encoded autobegin=1
set_venc o v
set_aenc o a
set_delay o 2
clock 1000000000
start o
state o
echo --- packets arrive but are queued (delay queue holds the START message + packets)
emit a 0 0 0 4
emit v 0 0 1 4
state o
echo --- exactly delay seconds later: still not released (strictly greater is required)
clock 3000000000
emit a 1024 1024 0 4
state o
echo --- one nanosecond more: the START message is released -> plugin start runs
clock 3000000001
emit a 2048 2048 0 4
state o
info o
echo --- the packets queued before the start are now released in order (and into the interleaver)
clock 5000000002
emit a 3072 3072 0 4
state o
queue o
