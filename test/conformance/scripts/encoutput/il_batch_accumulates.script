# QUIRK: interleaver_max_batch_size is accumulated with += and never reset, so it grows with every
# start of the same output object (5, 10, 15, ...).
video 30 1 1280 720
audio 48000
venc v
aenc a frame_size=1024
out o av,encoded autobegin=1
set_venc o v
set_aenc o a
start o
state o
stop o
start o
state o
stop o
start o
state o
stop o
