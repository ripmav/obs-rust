# Audio priming packets (dts <= 0) are kept and do not change the audio offset: the offset is only
# updated when the first audio dts is positive.
video 30 1 1280 720
audio 48000
venc v
aenc a frame_size=1024 dts_delay=1
out o av,encoded autobegin=1
set_venc o v
set_aenc o a
start o
emit a 0 -1024 0 4
emit a 1024 0 0 4
emit a 2048 1024 0 4
emit v 0 0 1 4
state o
emit a 3072 2048 0 4
emit v 1 1 0 4
emit a 4096 3072 0 4
stop o
