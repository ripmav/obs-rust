# S-045 build_dbr_interpolation_table: JSON [encoder][level] transposed into table[level].bitrates[encoder].
# Messages of the JSON parser itself (jansson) are not normative; only "a warning is logged".
reset
venc 0 h264 4000 64 e0
venc 1 h264 2000 64 e1
dbr_json "[[0,3000,4000],[0,1500,2000]]"
# a failed build leaves the previous table untouched (the table is only cleared after validation)
dbr_json "[[0,3000,4000],[0,1500]]"
dbr_json "[[0,3000,4000]]"
dbr_json "{}"
dbr_json "[]"
dbr_json "not json"
dbr_json "[[0,1],[0,1]] x"
dbr_json "[[1,2],[3,4],[5,6]]"
# negative and large values are plain integers
dbr_json "[[-1,2147483648],[0,9000000000]]"
# arrays of size 0: no table rows at all, still success
dbr_json "[[],[]]"
# QUIRK Q-3: the size check only compares sizes against the first NON-ZERO size, so an empty first array is accepted
# DEFECT D-1: the reference then dereferences a NULL entry while logging and crashes (SIGSEGV).
# Required behaviour: log a warning for the missing entry, leave it 0, and succeed.
probe dbr_json "[[],[0,1,2]]"
probe dbr_json "[[0,1,2],[]]"
# QUIRK Q-4: non-integer entries only log a warning; the entry stays 0 and the build still succeeds
dbr_json "[[0,1.5,3],[0,\"x\",null]]"
dbr_json "[[true,2],[3,4]]"
# sparse encoder indices: row j of the JSON belongs to encoder index j
reset
venc 0 h264 4000 64 e0
venc 2 h264 2000 64 e2
dbr_json "[[1,2],[9,9],[3,4]]"
dbr_json "[[1,2],[3,4]]"
# no video encoder: nothing to validate, nothing is built
reset
dbr_json "[[1,2]]"
