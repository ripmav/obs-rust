# S-045 net-if.c: textual <-> socket-address conversion (inet_pton/inet_ntop semantics on Linux).
# str_to_addr: a ':' anywhere selects IPv6, otherwise IPv4; the length is that of the chosen sockaddr even on failure.
reset
str_to_addr 192.168.1.20
str_to_addr 0.0.0.0
str_to_addr 255.255.255.255
str_to_addr 10.1.2
str_to_addr 256.1.1.1
str_to_addr " 1.2.3.4"
str_to_addr ""
str_to_addr -
str_to_addr ::1
str_to_addr ::
str_to_addr fe80::1
str_to_addr 2001:db8:0:0:0:0:0:1
str_to_addr ::ffff:1.2.3.4
str_to_addr "1.2.3.4:80"
str_to_addr "[::1]"
str_to_addr "fe80::1%eth0"
str_to_addr 12345::
# addr_to_str: output buffer must hold INET_ADDRSTRLEN (16) / INET6_ADDRSTRLEN (46); the buffer is zero-filled first
addr_to_str v4 c0a80114 16
addr_to_str v4 c0a80114 15
addr_to_str v4 ffffffff 16
addr_to_str v4 00000000 64
addr_to_str v6 00000000000000000000000000000001 46
addr_to_str v6 00000000000000000000000000000001 45
addr_to_str v6 00000000000000000000ffffc0a80114 46
addr_to_str v6 fe800000000000000000000012345678 46
addr_to_str v6 20010db8000000000000000000000001 80
addr_to_str v6 00000000000000000000000000000000 46
addr_to_str v6 20010db80000000100000000000000ff 46
addr_to_str other 00 64
