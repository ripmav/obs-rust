# S-045 output registration record, default settings and the property list shown to the user.
# Defaults are written only when the key has no user value. Windows-only keys are absent on Linux.
reset
info
defaults
# the bind-address combo is filled from the interface list; loopback is skipped, non-IP families skipped
ifa lo v4 127.0.0.1
ifa eth0 v4 192.168.1.20
ifa eth0 v6 fe80::1
ifa wlan0 v4 10.0.0.5
ifa weird other
ifa noaddr null
props
# no interfaces at all: only the "default" entry
ifa_clear
props
# getifaddrs failure behaves like an empty list (a warning is logged)
ifa_fail
props
