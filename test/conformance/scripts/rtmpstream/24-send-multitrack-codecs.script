# S-045 per-packet send path by track and codec: H.264 track 0 uses the legacy muxer; everything else the
# "enhanced RTMP" muxers; footers for non-legacy video tracks are sent on a clean stop.
reset
aenc 0 aac 160
aenc 1 aac 96
venc 0 h264 4000
venc 1 hevc 2000
venc 2 av1 1000
venc 3 h264 500
service rtmp://h/a KEY - -
init_connect
set active 1
pkt audio 100000 0 0 0
pkt audio 110000 0 0 1
pkt video 200000 3 1 0
pkt video 210000 3 1 1
pkt video 220000 3 1 2
pkt video 230000 3 1 3
pkt video 240000 2 0 0
stop 300000000
pkt audio 400000 0 0
run_send
# av1 on track 0: even the first track uses the enhanced path
reset
aenc 0 aac 160
venc 0 av1 4000
service rtmp://h/a KEY - -
init_connect
set active 1
pkt video 200000 3 1 0
pkt video 400000 3 1 0
stop 300000000
run_send
