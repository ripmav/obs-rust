# S-045 rtmp_stream_destroy: which threads are joined/signalled depending on the state (threads are fakes).
reset
getters
# idle
pkt video 1 3 1
destroy
# active (send thread running): capture ended, stop event, send thread released and joined
set active 1
pkt video 100000 3 1
pkt audio 110000 0 0
destroy
# connecting and active
set connecting 1
set active 1
destroy
# connecting only
set connecting 1
destroy
# stopping already (stop event set) and not connecting: only the send thread is joined
set stop_event 1
destroy
# stopping while connecting: falls to the second branch
set stop_event 1
set connecting 1
destroy
# stopping, connecting and active
set stop_event 1
set connecting 1
set active 1
destroy
