# Cache management.  A cache entry is "used" (u=1) from ingest until its frame is replaced by the next selection or
# released.  Unused entries are reused (first unused entry in cache order) for later frames; every ingest then
# increments the unused counter of the remaining unused entries and frees an entry when its counter reaches 5.
# The cache listing is [used/unused_count,...].  A change of width/height/convert class empties cache and queue.
kind cam input asyncvideo
create c cam C
video c bgra 2 2 1000000000 1 1 0
video c bgra 2 2 1010000000 1 2 0
video c bgra 2 2 1020000000 1 3 0
astate c
vtime 100000000
tick c 0.016
vtime 200000000
tick c 0.016
astate c
vtime 300000000
tick c 0.016
astate c
echo --- five ingest+select cycles: entry 0 is reused every time, entries 1 and 2 age and are freed at the 5th
video c bgra 2 2 1100000000 1 4 0
vtime 400000000
tick c 0.016
astate c
video c bgra 2 2 1110000000 1 5 0
vtime 500000000
tick c 0.016
astate c
video c bgra 2 2 1120000000 1 6 0
vtime 600000000
tick c 0.016
astate c
video c bgra 2 2 1130000000 1 7 0
vtime 700000000
tick c 0.016
astate c
video c bgra 2 2 1140000000 1 8 0
vtime 800000000
tick c 0.016
astate c
echo --- geometry change empties everything
video c bgra 4 4 1070000000 1 8 0
astate c
echo --- bgra to rgba keeps the same convert class
video c rgba 4 4 1080000000 1 9 0
astate c
echo --- bgra to i420 changes class
video c i420 4 4 1090000000 0 9 0
astate c
echo --- video_null resets everything
video_null c
astate c
