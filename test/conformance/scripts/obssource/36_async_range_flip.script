# output_video forces full_range = true for non-YUV formats; for YUV formats the flag is taken from the frame.
# output_video2 resolves the range: DEFAULT -> limited for YUV, full for RGB; PARTIAL / FULL as given.
# flip and timestamp are copied.
kind cam input asyncvideo
create c cam C
echo --- output_video
video c bgra 2 2 100 0 1 1
vtime 100000000
tick c 0.01
get_frame c
release_frame c
video c i420 2 2 200 0 2 0
vtime 200000000
tick c 0.01
get_frame c
release_frame c
video c i420 2 2 300 1 3 0
vtime 300000000
tick c 0.01
get_frame c
release_frame c
echo --- output_video2 (range arg: 0 default, 1 partial, 2 full)
video2 c i420 2 2 400 0 4 0
vtime 400000000
tick c 0.01
get_frame c
release_frame c
video2 c i420 2 2 500 2 5 0
vtime 500000000
tick c 0.01
get_frame c
release_frame c
video2 c bgra 2 2 600 1 6 0
vtime 600000000
tick c 0.01
get_frame c
release_frame c
video2 c bgra 2 2 700 0 7 0
vtime 700000000
tick c 0.01
get_frame c
release_frame c
