# Unbuffered async sources: on every tick all queued frames except the newest are dropped and the newest is shown
# immediately; last_frame_ts follows the frame.
kind cam input asyncvideo
create c cam C
unbuffered c 1
video c bgra 2 2 1000 1 1 0
video c bgra 2 2 2000 1 2 0
video c bgra 2 2 3000 1 3 0
astate c
vtime 100
tick c 0.016
astate c
get_frame c
release_frame c
video c bgra 2 2 9000000000 1 4 0
vtime 200
tick c 0.016
astate c
