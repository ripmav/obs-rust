# slideshow (v1): creation registers hotkeys/procs/signal; configuration happens on the first tick (CORE).
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
img /s/a.png 100 50
img /s/b.png 200 40
img /s/c.png 80 120
info slideshow
defaults slideshow
create ss slideshow {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"},{"value":"/s/c.png"}],"slide_time":1000,"transition_speed":200}
connect ss slide_changed
size ss
proc ss total_files
proc ss current_index
state ss
tick 0.016
size ss
state ss
proc ss total_files
proc ss current_index
mediastate ss
