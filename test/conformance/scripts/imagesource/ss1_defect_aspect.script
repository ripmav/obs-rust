# slideshow v1 DEFECT: "W:H" custom sizes with a zero or negative component convert an infinite/negative double to
# uint32 (undefined behaviour in the reference; x86-64 yields 0). Required behaviour: no crash, value 0 for the
# affected dimension (x86-64 result), other dimension unchanged.
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss slideshow {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"}]}
tick 0.016
update ss {"use_custom_size":"16:0"}
tick 0.016
size ss
update ss {"use_custom_size":"-16:9"}
tick 0.016
size ss
update ss {"use_custom_size":"0:0"}
tick 0.016
size ss
update ss {"use_custom_size":"0:5"}
tick 0.016
size ss
