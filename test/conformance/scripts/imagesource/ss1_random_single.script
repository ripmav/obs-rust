# slideshow v1: random with one file never calls rand (CORE); with zero files nothing is selected.
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss slideshow {"files":[{"value":"/s/a.png"}],"randomize":true}
tick 0.016
state ss
create e slideshow {"files":[],"randomize":true}
tick 0.016
state e
size e
