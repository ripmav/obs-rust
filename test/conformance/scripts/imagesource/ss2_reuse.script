# slideshow v2: update recreates every slide source (previous slide buffers are freed before the new list is built);
# restart/stop (media restart) reuse the sources already held (QUIRK).
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss slideshow_v2 {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"}],"transition":"cut","transition_speed":0}
tick 0.016
update ss {"files":[{"value":"/s/b.png"},{"value":"/s/c.png"}]}
tick 0.016
state ss
media ss restart
tick 0.016
state ss
update ss {"files":[]}
tick 0.016
state ss
size ss
tick 3 3
destroy ss
