# slideshow v1: random order. rand() is the scripted sequence. The start index is chosen with the same "differs from
# the current item" loop, so index 0 is never the first slide when there are >= 2 files (QUIRK). Index = rand mod count.
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
rand 4 4 7 8 9 5 2
create ss slideshow {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"},{"value":"/s/c.png"},{"value":"/s/d.png"}],"randomize":true,"slide_time":100,"transition_speed":0,"transition":"cut"}
connect ss slide_changed
tick 0.016
state ss
refs ss 1 1
tick 0.2
tick 0.016
tick 0.016
tick 0.2
tick 0.016
state ss
