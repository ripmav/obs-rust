# slideshow v1: custom size setting parsing (CORE and QUIRK for malformed strings).
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss slideshow {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"}]}
tick 0.016
size ss
update ss {"use_custom_size":"1280x720"}
tick 0.016
size ss
update ss {"use_custom_size":"640x480junk"}
tick 0.016
size ss
update ss {"use_custom_size":"16:9"}
tick 0.016
size ss
update ss {"use_custom_size":"1:1"}
tick 0.016
size ss
update ss {"use_custom_size":"garbage"}
tick 0.016
size ss
update ss {"use_custom_size":"-5x7"}
tick 0.016
size ss
update ss {"use_custom_size":"0x0"}
tick 0.016
size ss
update ss {"use_custom_size":"SlideShow.CustomSize.Auto"}
tick 0.016
size ss
