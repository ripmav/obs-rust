# slideshow v2: hotkeys act only while the source is showing; next/previous hotkeys only in manual mode (CORE).
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss slideshow_v2 {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"},{"value":"/s/c.png"}],"transition":"cut","transition_speed":0}
tick 0.016
hotkey ss SlideShow.NextSlide 1
tick 0.016
refs ss 1 1
hotkey ss SlideShow.NextSlide 1
tick 0.016
state ss
hotkey ss SlideShow.PlayPause 1
tick 0.016
mediastate ss
state ss
hotkey ss SlideShow.NextSlide 1
tick 0.016
state ss
hotkey ss SlideShow.NextSlide 0
hotkey ss SlideShow.PreviousSlide 1
tick 0.016
state ss
hotkey ss SlideShow.Stop 1
tick 0.016
mediastate ss
hotkey ss SlideShow.PlayPause 1
tick 0.016
mediastate ss
hotkey ss SlideShow.Restart 1
tick 0.016
mediastate ss
state ss
