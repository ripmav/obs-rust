# slideshow v2: end of playlist when not looping: stays on the last slide, or fades to nothing with hide=1 (media_ended) (CORE).
fs_file /s/a.png 1
fs_file /s/b.png 1
fs_file /s/c.png 1
fs_file /s/d.png 1
img /s/a.png 10 10
img /s/b.png 20 20
img /s/c.png 30 30
img /s/d.png 40 40
create ss1 slideshow_v2 {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"}],"slide_time":100,"transition_speed":0,"transition":"cut","loop":false,"playback_mode":"once"}
connect ss1 slide_changed
tick 0.016
refs ss1 1 1
tick 0.2 8
state ss1
mediastate ss1
create ss2 slideshow_v2 {"files":[{"value":"/s/a.png"},{"value":"/s/b.png"}],"slide_time":100,"transition_speed":0,"transition":"cut","loop":false,"playback_mode":"once","hide":true}
connect ss2 slide_changed
tick 0.016
refs ss2 1 1
tick 0.2 8
state ss2
mediastate ss2
render ss2
