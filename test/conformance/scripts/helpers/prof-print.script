# profiler_print: human readable report (CORE; the logged text of this script is normative
# and compared byte for byte, shown as `text "..."` lines). Covers the tree drawing
# characters, the min/median/max/99th percentile line, the single-value shortcut and the
# "calls per parent call" suffix.
p_name 0 frame
p_name 1 update
p_name 2 render
p_name 3 draw
p_begin
p_clock 1000
p_call 3 100000
p_start 0
p_start 1
p_tick 200000
p_end 1
p_start 2
p_start 3
p_tick 300000
p_end 3
p_start 3
p_tick 400000
p_end 3
p_start 3
p_tick 500000
p_end 3
p_end 2
p_end 0
p_start 0
p_start 1
p_tick 250000
p_end 1
p_end 0
p_print
p_free
