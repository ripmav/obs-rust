# Time-between-calls edge cases (CORE): all gaps above the window ("100% higher"),
# all below the window ("100% lower"), and a root with expectation but a single call (no
# between-call samples, so zeros are printed).
p_name 0 slow
p_name 1 fast
p_name 2 once
p_begin
p_root 0 1000000
p_root 1 1000000
p_root 2 1000000
p_clock 0
p_call 0 1000
p_tick 4000000
p_call 0 1000
p_tick 4000000
p_call 0 1000
p_call 1 1000
p_tick 100000
p_call 1 1000
p_tick 100000
p_call 1 1000
p_call 2 5000
p_snap
p_dump
p_print_between snap
p_free
