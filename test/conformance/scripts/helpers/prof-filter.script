# profiler_snapshot_filter_roots(): the callback decides per root whether to remove it and
# whether to continue (CORE). Runner callback: removes roots whose name starts with the given
# prefix and stops after the root called "stop".
p_name 0 keep1
p_name 1 drop1
p_name 2 keep2
p_name 3 drop2
p_name 4 stop
p_name 5 drop3
p_begin
p_clock 0
p_call 0 1000
p_call 1 1000
p_call 2 1000
p_call 3 1000
p_call 4 1000
p_call 5 1000
p_snap
p_dump
p_filter drop
p_dump
p_null
p_free
