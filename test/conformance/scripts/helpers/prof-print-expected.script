# profiler_print for a root that has an expected interval and varying durations (CORE):
# the line gets a ", P% below E ms" suffix, P = share of calls shorter than the expected
# interval (printed with %g). Also a second root shows that an unset expectation prints no
# suffix.
p_name 0 frame
p_name 1 other
p_begin
p_root 0 2500000
p_clock 0
p_call 0 1000000
p_call 0 2000000
p_call 0 2000000
p_call 0 3000000
p_call 0 4000000
p_call 0 2400000
p_call 0 2500000
p_call 0 2600000
p_call 0 100000
p_call 0 9000000
p_call 1 1000000
p_call 1 2000000
p_snap
p_print snap
p_free
