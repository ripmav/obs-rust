# CORPUS (CORE): every shipped effect file of this group is parsed by the real effect parser against the fake
# OpenGL backend (preprocessor name _OPENGL). For each file the runner prints, in order: the backend calls
# (location string, exact assembled shader text, shader parameters), the creation result, the effect structure
# (parameters with types and defaults, techniques, passes with the parameters bound to each shader) and the
# parser-internal structure (counts, struct/function/sampler/technique tables, dependency lists). The files
# are read from the repository; the file name given to the parser is the repository relative path (it also
# decides where "#include" is resolved; the runner starts in the repository root).
gfx _OPENGL
echo === libobs/data/deinterlace_base.effect
backend text full
backend events off
effect e libobs/data/deinterlace_base.effect @file:libobs/data/deinterlace_base.effect
dump e
backend text none
backend ep brief
ep libobs/data/deinterlace_base.effect @file:libobs/data/deinterlace_base.effect
destroy e
echo === libobs/data/deinterlace_blend.effect
backend text full
backend events off
effect e libobs/data/deinterlace_blend.effect @file:libobs/data/deinterlace_blend.effect
dump e
backend text none
backend ep brief
ep libobs/data/deinterlace_blend.effect @file:libobs/data/deinterlace_blend.effect
destroy e
