# CORE: struct declarations. "struct NAME { TYPE NAME [: MAPPING]; ... };"
# Members are (type name) pairs with an optional semantic; no qualifiers, arrays or initialisers.
# A member that does not fit is skipped up to the next ';' (or '}') WITHOUT an error message in several cases,
# which is why some inputs below produce fewer members than written. Struct names may repeat (no check).
backend text none
ep s1 "struct A { float x; float2 y : TEXCOORD0; };"
ep s2 "struct A { };"
ep s3 "struct A { float4 pos : POSITION; float4 col : COLOR; float2 uv : TEXCOORD0; float4 n : NORMAL; };"
ep s4 "struct A { float x;; ; float y; };"
ep s5 "struct A { float x; }; struct B { A a; float y; };"
ep s6 "struct A { float x; }; struct A { float y; };"
ep s7 "struct A { float x[2]; float z; };"
ep s8 "struct A { float x = 3; float z; };"
ep s9 "struct A { uniform float x; float z; };"
ep s10 "struct A { float x : POSITION : COLOR; float z; };"
ep s11 "struct A { float x ; float y };"
ep s12 "struct A { float x; } float y;"
ep s13 "struct A { float x; }  ;  float y;"
ep s14 "struct A{float x:POSITION;}; float y;"
echo --- errors
ep e1 "struct"
ep e2 "struct A"
ep e3 "struct A {"
ep e4 "struct A { float x }"
ep e5 "struct A { float x; "
ep e6 "struct A { float ; float y; };"
ep e7 "struct A { float x : ; float y; };"
ep e8 "struct A { float x : 1; float y; };"
ep e9 "struct A { 3 x; };"
ep e10 "struct { float x; };"
ep e11 "struct A float x; };"
ep e12 "struct 3 { float x; };"
ep e13 "struct A { float 3; };"
ep e14 "struct A { float x : POSITION };"
ep e15 "struct A { float x }; float y;"
ep e16 "struct A { float x; float }; float y;"
ep e17 "struct A { float x : ; };"
ep e18 "struct A { float : POSITION; };"
ep e19 "struct A { float x; }; }"
ep e20 "struct A { float x; } = 3;"
