# CORE: #if with identifier/number operands and comparators == != < > <= >=, #elif chains, malformed conditions.
parse "#define V 3\n#if V == 3\na\n#else\nb\n#endif\n#if V >= 4\nc\n#elif V < 3\nd\n#elif V\ne\n#else\nf\n#endif\n#if 0\ng\n#else\nh\n#endif\n#if V\ni\n#endif\n#if 0x10 == 16\np\n#endif\n#if 1 != 1\nq\n#endif\n#if 2 <= 1\nr\n#endif\n#if 2 > 1\ns\n#endif\n"
tokens pp
errors
reset
parse "#define V 3\n#if V = 3\nj\n#endif\n#if V ~ 3\nk\n#endif\n#if W\nl\n#endif\n#if\nm\n#endif\n#if 1 == W\nn\n#endif\n#if 1 ==\no\n#endif\n#if 1 == 1 junk\nq\n#endif\n"
tokens pp
errors
reset
parse "#define A B\n#define B 2\n#define M(x) 2\n#if A == 2\nyes\n#endif\n#if M == 2\nno\n#endif\n"
