# S-044: frame cache ring. lock_frame hands out the next cache slot, unlock_frame wakes the video thread, the thread
# calls every input once per count, advancing the timestamp by frame_time (33333333 ns at 30 fps) after each pass.
vopen v I420 30 1 16 8 3
vconnect v a 1
# first frame -> slot 0, subsequent frames take the following slots, wrapping at cache_size
vlock v 1 1000 0x11
vunlock v
vdump v
vlock v 1 2000 0x22
vunlock v
vlock v 1 3000 0x33
vunlock v
vlock v 1 4000 0x44
vunlock v
vdump v
vstate v
# locking without any input connected still runs the thread (frames are counted)
vdisconnect v a 1
vlock v 1 5000 0x55
vunlock v
vstate v
vclose v
