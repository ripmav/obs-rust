# S-044: removal. disconnect2 reports whether an input was removed; removing the last input clears the active flag and
# logs the skipped-frame summary only if frames were skipped; input order of the remaining inputs is preserved.
vopen v I420 30 1 16 8 2
vconnect v a 1
vconnect v a 2
vconnect v b 3
vdisconnect2 v a 2
vdisconnect2 v a 2
vdisconnect2 v b 99
vdisconnect_nocb v
vinputs v
vstate v
vdisconnect2 v a 1
vstate v
vdisconnect v b 3
vstate v
vinputs v
# create lag so that skipped_frames > 0, then removing the last input logs the summary
vconnect v a 1
vgate on
vlock v 1 1 0x01
vunlock_async v
venter
vlock v 1 2 0x02
vunlock_async v
vlock v 1 3 0x03
vlock v 1 4 0x04
vgate off
vrelease 1
vwait 2
vstate v
vdisconnect2 v a 1
vstate v
vclose v
