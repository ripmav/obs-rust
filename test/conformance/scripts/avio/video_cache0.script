# S-044: cache_size 0 is accepted by open; every lock_frame then fails (no free slot) and merely accumulates
# count/skipped on slot 0, which no thread ever consumes. (Edge of the preconditions: cache_size is normally >= 1.)
vopen v I420 30 1 16 8 0
vlock v 1 100 0x01
vlock v 2 200 0x02
vdump v
vstate v
vclose v
# cache_size 1: one frame in flight at a time
vopen w I420 30 1 16 8 1
vconnect w a 1
vgate on
vlock w 1 10 0x0a
vunlock_async w
venter
vlock w 1 20 0x0b
vdump w
vgate off
vrelease 1
vwait 1
vdump w
vstate w
vclose w
