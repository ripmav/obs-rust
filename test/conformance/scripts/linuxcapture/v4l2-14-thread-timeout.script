# S-049 v4l2: capture thread start-up: the select() timeout is timeout_frames / fps, truncated to whole
# microseconds (computed in float); STREAMON failure ends the thread; the thread always STREAMOFFs on exit.
trace on
fake-dir video0
dev /dev/video0
dev-cap "Cam" usb-1 0x85200001 0x05200001
dev-input Camera 0
dev-cur 0 640 480 YUYV 1280 1 30 0
src-defaults
set-str device_id /dev/video0
set-int pixelformat 0x56595559
src-create
src-thread-run
set-int timeout_frames 2
set-int framerate 4294967356
src-update
src-thread-run
set-int timeout_frames 120
set-int framerate 4294967301
src-update
src-thread-run
# NTSC 30000/1001 style rate: numerator 1001, denominator 30000
set-int timeout_frames 5
set-int framerate 4299262264240
src-update
src-thread-run
fail STREAMON
src-thread-run
src-destroy
