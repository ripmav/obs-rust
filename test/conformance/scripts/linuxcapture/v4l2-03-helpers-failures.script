# S-049 v4l2: error propagation of the helpers. An injected ioctl failure makes the helper return -1
# and leave caller values unchanged (set_format/set_framerate only write outputs on success).
trace on
dev /dev/video0
dev-cur 0 640 480 YUYV 1280 1 30 0
h-open /dev/video0
fail G_FMT
h-set-format 8246337209400 NV12
unfail
fail S_FMT
h-set-format 8246337209400 NV12
unfail
# S_FMT is skipped when nothing is requested
fail S_FMT
h-set-format -1 -1
unfail
fail S_PARM
h-set-framerate 4294967326
unfail
fail G_PARM
h-set-framerate -1
unfail
fail G_INPUT
h-set-input -1
h-input-caps -1
unfail
fail ENUMINPUT
h-input-caps 0
unfail
fail S_STD
h-set-standard 5
unfail
fail G_STD
h-set-standard -1
unfail
dev-dv 1280 720 74250000 110 40 220 5 5 20 0 0 0 0
fail S_DV_TIMINGS
h-set-dv 0
unfail
