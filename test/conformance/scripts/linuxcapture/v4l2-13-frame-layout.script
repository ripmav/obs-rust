# S-049 v4l2: obs_source_frame preparation for planar / packed pixel formats (plane offsets inside the single
# mmap buffer and linesizes) and the capture thread's select-timeout computation.
fake-dir video0
dev /dev/video0
dev-cap "Cam" usb-1 0x85200001 0x05200001
dev-input Camera 0
dev-cur 0 640 480 YUYV 1280 1 30 0
src-defaults
set-str device_id /dev/video0
set-int pixelformat 0x56595559
src-create
src-field width 640
src-field height 480
src-field linesize 1280
src-field pixfmt YUYV
src-prep-frame
src-field linesize 640
src-field pixfmt NV12
src-prep-frame
src-field pixfmt YU12
src-prep-frame
src-field pixfmt YV12
src-prep-frame
src-field linesize 2560
src-field pixfmt XR24
src-prep-frame
src-field linesize 1920
src-field pixfmt BGR3
src-prep-frame
# MJPEG: no OBS format; frame starts cleared (format NONE), decoder fills it later
src-field pixfmt MJPG
src-prep-frame
# odd sizes: chroma linesize uses integer division, offsets integer arithmetic
src-field width 5
src-field height 3
src-field linesize 5
src-field pixfmt YU12
src-prep-frame
src-field pixfmt YV12
src-prep-frame
# color range setting is passed to the color-matrix helper (0 default, 1 partial, 2 full)
src-field color_range 2
src-field pixfmt NV12
src-prep-frame
src-field color_range 1
src-prep-frame
