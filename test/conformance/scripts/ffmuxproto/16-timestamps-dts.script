# dts conversion and reordering: the mov/mp4 muxer stores decode times. B-frame style stream (pts != dts).
reset
rmfile @ts.mp4
args @ts.mp4 1 0 h264 6000 640 360 1 1 1 1 1 0 30 1 0 "" ""
hdr video 0 0164001fffe100046764001f01000468ce3c80
frame video 0 1 2 0 4 a0
frame video 0 0 4 1 4 a1
frame video 0 0 3 2 4 a2
frame video 0 0 5 3 4 a3
run
probe @ts.mp4 rel
