# max luminance > 0 adds content-light-level and mastering-display side data (fixed BT.2020 primaries);
# the other colour fields are passed through verbatim.
reset
args @s3.mkv 1 0 vp9 20000 3840 2160 9 16 9 1 3 1000 60 1 0x00000000 "" ""
hdr video 0 -
inspect
reset
echo --- max luminance 0 and negative: no side data
args @s3.mkv 1 0 vp9 20000 3840 2160 9 16 9 1 3 0 60 1 0 "" ""
hdr video 0 -
inspect
args @s3.mkv 1 0 vp9 20000 3840 2160 9 16 9 1 3 -5 60 1 0 "" ""
inspect
