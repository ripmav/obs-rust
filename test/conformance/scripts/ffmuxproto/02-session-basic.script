# A complete recording session: 1 video + 1 audio track, headers, packets, EOF -> clean exit, then re-read the file.
reset
rmfile @s1.mkv
args @s1.mkv 1 1 h264 6000 1920 1080 1 1 1 1 1 0 30 1 0 aac "Track1" 160 48000 1024 1024 2 "" ""
hdr video 0 0164001fffe100046764001f01000468ce3c80
hdr audio 0 1190
frame video 0 1 0 0 8 61
frame audio 0 0 0 0 4 71
frame video 0 0 1 1 6 62
frame video 0 0 2 2 6 63
frame audio 0 0 1024 1024 4 72
dump
run
probe @s1.mkv
