hex
echo --- sample rate 96000 is fine, 192000 does not fit the 16.16 field
reset
enc a audio codec aac rate 96000 extra 1190
mux mp4 skipfin
pkt a 0 0 1 gen:10
finalise
hex
reset
enc a audio codec aac rate 192000 extra 1190
mux mp4 skipfin
pkt a 0 0 1 gen:10
finalise
hex
echo --- flac and opus in 5.1 get chnl too; mono pcm gets definedLayout 1
reset
enc a audio codec flac rate 48000 speakers 5.1 extra 1000100000000b000000150ac4400000000000000000000000000000000000
mux mp4 skipfin
pkt a 0 0 1 gen:10
finalise
tree
