# S-022 B-frames: decode order I P B B P B B with pts/dts below (dts starts at -2).
# composition offset = pts - dts per sample: 2 4 1 1 4 1 1 -> ctts runs (2,1)(4,1)(1,2)(4,1)(1,2).
# The edit list media_time is the FIRST ctts run's offset (2 ticks); mvhd/tkhd/elst durations are
# in milliseconds (7 frames at 30 fps = 233 ms, truncated). stss lists sample 1 only.
enc v video codec h264 width 640 height 360 fps 30/1 extra 000000016742c01ed900a047fe880000000168ce3c80
mux mp4
pkt v 0 -2 1 gen:20
pkt v 3 -1 0 gen:12
pkt v 1 0 0 gen:13
pkt v 2 1 0 gen:14
pkt v 6 2 0 gen:15
pkt v 4 3 0 gen:16
pkt v 5 4 0 gen:17
finalise
dump
