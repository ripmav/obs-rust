# RTMP_SendPacket header selection: Large/Medium/Small/Minimum compression, basic-header forms (1, 2, 3 bytes),
# extended timestamps, wire-delta bookkeeping and error return for an invalid header type (R54..R62).
new
clock 1000
seturl rtmp://h/a
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
sendpacket 3 0 20 5 0 0102 0
sendpacket 3 1 20 10 0 0102 0
sendpacket 3 1 20 20 0 0102 0
sendpacket 3 1 20 30 0 0102 0
sendpacket 3 1 21 40 0 0102 0
sendpacket 3 1 21 50 0 0102 0
sendpacket 3 2 21 60 0 0102 0
sendpacket 3 1 21 70 0 0102 0
sendpacket 3 1 21 80 0 0102 0
sendpacket 3 0 9 0 7 - 0
sendpacket 63 0 9 1 7 aa 0
sendpacket 64 0 9 1 7 aa 0
sendpacket 319 0 9 1 7 aa 0
sendpacket 320 0 9 1 7 aa 0
sendpacket 65599 0 9 1 7 aa 0
sendpacket 6 0 9 16777214 1 aa 0
sendpacket 6 0 9 16777215 1 aa 0
sendpacket 6 0 9 16777216 1 aa 0
sendpacket 6 1 9 16777216 1 aa 0
sendpacket 6 3 9 16777300 1 aa 0
sendpacket 6 3 9 16777384 1 aa 0
sendpacket 7 0 9 5 0 aa 0
sendpacket 7 1 9 3 0 bb 0
sendpacket 7 1 9 1 0 cc 0
sendpacket 7 0 9 4294967295 0 aa 0
sendpacket 7 1 9 2 0 bb 0
sendpacket 7 4 9 0 0 aa 0
