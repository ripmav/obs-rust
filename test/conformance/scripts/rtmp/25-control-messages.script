# ClientPacket dispatch for control messages: ping -> pong (type 7) with the server value, other user-control events are
# logged, SWF verification without SWF info is ignored, short messages are tolerated (R84..R92).
new
clock 1000
seturl rtmp://h/a
enablewrite
set flashver FMLE
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
feed 020000000000060400000000000000000001
feed 020000000000060400000000000612345678
feed 020000000000060400000000000100000001
feed 020000000000060400000000001f00000001
feed 020000000000060400000000002000000001
feed 020000000000060400000000000300000001
feed 02000000000001040000000000
feed 020000000000080400000000001a000000000000
feed 020000000000040300000000000003e8
feed 020000000000040600000000000003e8
feed 02000000000004050000000000000004
feed 0200000000000201000000000000
feed 050000000000010f0000000078
feed 05000000000001130000000078
feed 05000000000001630000000078
client
client
client
