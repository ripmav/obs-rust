# SecureToken (legacy Justin.tv): the server sends secureToken in the connect _result, the engine decrypts the hex text
# with XXTEA keyed by the first 16 bytes of the token option and answers secureTokenResponse (R113).
new
clock 1000
seed 3
seturl rtmp://h/app
addstream vid.mp4
set token "0123456789abcdefXY"
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000004814000000000200075f726573756c74003ff00000000000000503000b736563757265546f6b656e0200203030313132323333343435353636373738383939616162626363646465656666000009
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000001d14000000000200075f726573756c7400400000000000000005003ff0000000000000
feed 0300000000005714000000000200086f6e537461747573000000000000000000050300056c6576656c0200067374617475730004636f64650200144e657453747265616d2e506c61792e5374617274000b6465736372697074696f6e02000164000009
connect
connectstream
