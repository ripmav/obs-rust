# Bandwidth check and ping invokes before Publish.Start (R44..R47): onBWDone sends _checkbw once while the counter
# is 0; _onbwcheck is answered with _result carrying the running counter; ping is answered with pong.
new
clock 123450
seed 7
seturl rtmp://live.example.com/app
enablewrite
set flashver "FMLE/3.0 (compatible; FMSc/1.0)"
set swfurl_is_tcurl 1
addstream mystream
set outchunk 4096
set chunkinfo 1
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000003914000000000200086f6e4257446f6e65000000000000000000050040c40000000000000040c4000000000000000000000000000000000000000000000000
feed 0300000000001b140000000002000a5f6f6e6277636865636b0040140000000000000502000178
feed 0300000000001b140000000002000a5f6f6e6277636865636b0040180000000000000502000178
feed 0300000000001514000000000200086f6e4257446f6e6500000000000000000005
feed 0300000000001614000000000200095f6f6e6277646f6e6500000000000000000005
feed 03000000000011140000000002000470696e6700402200000000000005
feed 0300000000001a140000000002000d6f6e464353756273637269626500000000000000000005
feed 0300000000001a140000000002000d756e6b6e6f776e4d6574686f6400000000000000000005
feed 0300000000001d14000000000200075f726573756c7400401000000000000005003ff0000000000000
feed 0300000000005a14000000000200086f6e537461747573000000000000000000050300056c6576656c0200067374617475730004636f64650200174e657453747265616d2e5075626c6973682e5374617274000b6465736372697074696f6e02000164000009
connect
connectstream
state
