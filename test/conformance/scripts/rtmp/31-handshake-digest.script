# Digest handshake, used only when SWFSize != 0 (R35..R39). The harness server computes S1 (key: first 36 bytes of the FMS key) and
# S2 (digest of the client digest) with HMAC-SHA256; see spec 3.2. SWF verification request answered with user control 0x1B.
echo digest-alg0
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed_s1 0 1000 09007c00
feed_digest 0
connect
state
echo digest-alg1
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed_s1 1 1000 09007c00
feed_digest 0
connect
echo bad-server-digest
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed 
feed_digest 0
connect
state
echo bad-s2-signature
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed_s1 0 1000 09007c00
feed_echo
connect
state
echo zero-server-version-falls-back-to-plain
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
echo swf-verification-request
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set swfsize 12345
set swfhash 0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
feed 03
feed_s1 0 1000 09007c00
feed_digest 0
feed 020000000000030400000000001a01
feed 020000000000030400000000001a02
connect
client
client
