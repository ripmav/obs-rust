# Send failures close the connection (error return, SO_LINGER abortive close), EINTR is retried, connector failures,
# operations on a closed engine, host brackets are stripped, over-long connect object fails (R122..R129).
echo send-fails-in-handshake
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
sendfail 1000 32
connect
state
echo send-fails-after-connect
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
sendfail 0 32
sendpacket 6 0 9 1 1 aa 0
state
sendfail -1 0
echo eintr-is-retried
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
sendeintr
connect
state
echo connector-fails
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
hevfail 111
connect
state
echo write-on-closed-connection
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
close
writetag 9 0 10 0 1
sendpacket 6 0 9 1 1 aa 0
sendfn createstream
state
echo ipv6-host
new
clock 1000
seed 3
seturl rtmp://[2001:db8::1]:1936/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
echo connect-packet-too-large
new
clock 1000
seed 3
seturl rtmp:
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
connect
state
