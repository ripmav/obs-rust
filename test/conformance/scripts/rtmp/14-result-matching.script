# _result handling: txn matching against the call queue, unmatched results, _result for publish (R40..R43).
new
clock 123450
seed 7
seturl rtmp://live.example.com/app
enablewrite
set flashver "FMLE/3.0 (compatible; FMSc/1.0)"
set swfurl_is_tcurl 1
addstream mystream
set outchunk 4096
set chunkinfo 1
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000001414000000000200075f726573756c74004058c0000000000005
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000001d14000000000200075f726573756c740040100000000000000500401c000000000000
feed 0300000000001414000000000200075f726573756c7400401400000000000005
connect
connectstream
state
