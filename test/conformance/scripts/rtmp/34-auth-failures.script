# PublisherAuth failure paths: the engine logs and keeps the connection (no close, no reconnect) (R103).
echo adobe-authfailed
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
set user bob
set pass secret
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 
connect
connectstream
state
