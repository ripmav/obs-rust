# onStatus codes: failure codes close the connection (after FCUnpublish/deleteStream when the stream id is
# known); unknown codes only log (R48..R52).
echo NetConnection.Connect.InvalidApp
new
clock 123450
seed 7
seturl rtmp://live.example.com/app
enablewrite
set flashver "FMLE/3.0 (compatible; FMSc/1.0)"
set swfurl_is_tcurl 1
addstream mystream
set outchunk 4096
set chunkinfo 1
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000001d14000000000200075f726573756c7400401000000000000005003ff0000000000000
feed 0300000000006214000000000200086f6e537461747573000000000000000000050300056c6576656c0200056572726f720004636f64650200204e6574436f6e6e656374696f6e2e436f6e6e6563742e496e76616c6964417070000b6465736372697074696f6e02000164000009
connect
connectstream
state
