# RTMP_ParseURL: scheme table, host/port/app splitting (rules S-031-R01..R10).
parseurl rtmp://live.example.com/app
parseurl rtmp://live.example.com:1936/app/inst
parseurl RTMPS://h/a
parseurl rtmpt://h/a
parseurl rtmpe://h/a
parseurl rtmfp://h/a
parseurl rtmpte://h/a
parseurl rtmpts://h/a
parseurl http://h/a
parseurl rtmpx://h:99/a
parseurl nourl
parseurl rtmp://
parseurl rtmp://host
parseurl rtmp://host:80
parseurl rtmp://host/
parseurl rtmp://host//
parseurl rtmp://host/app/
parseurl rtmp://host/app//
parseurl rtmp://host/app?x=1&y=2
parseurl rtmp://host:65535/a
parseurl rtmp://host:65536/a
parseurl rtmp://host:0/a
parseurl rtmp://host:abc/a
parseurl rtmp://host:-5/a
parseurl rtmp://host:12ab/a
parseurl rtmp://[::1]/live
parseurl rtmp://[::1]:1936/live
parseurl rtmp://[2001:db8::1]/live/x
parseurl rtmp://host/a:b
parseurl rtmp://a:b:c/x
