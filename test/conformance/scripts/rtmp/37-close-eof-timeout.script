# Connection end behaviour: peer EOF / reset closes the engine (sending FCUnpublish + deleteStream first when a stream id
# is known), a receive timeout only sets the timed-out flag, explicit Close, server close invokes (R114..R121).
echo eof-before-createstream-result
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
empty eof
connect
connectstream
state
echo eof-after-publish-id-known
new
clock 1000
seed 3
seturl rtmp://h/a
enablewrite
set flashver FMLE
addstream key
feed 03
feed_s1 0 1000 00000000
feed_echo
feed 0300000000001414000000000200075f726573756c74003ff000000000000005
feed 0300000000001d14000000000200075f726573756c7400401000000000000005003ff0000000000000
empty eof
connect
connectstream
state
