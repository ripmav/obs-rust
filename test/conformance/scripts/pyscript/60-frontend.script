echo removal API
py_begin fe2.py
import obspython as obs
def ev(e):
    print("fe2 event", e)
def sv(d, s):
    print("fe2 save", s)
def script_load(settings):
    obs.obs_frontend_add_event_callback(ev)
    obs.obs_frontend_add_save_callback(sv)
def script_update(settings):
    obs.obs_frontend_remove_event_callback(ev)
    obs.obs_frontend_remove_save_callback(sv)
py_end
create S1 fe2.py
fe_event 1
fe_save 1
echo unload: libobs drops the callbacks on the next event
destroy S0
fe_event 1
fe_save 1
scripting unload
