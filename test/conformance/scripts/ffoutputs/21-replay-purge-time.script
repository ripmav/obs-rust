# Time-limited ring: before a packet is queued, whole groups of pictures are dropped from the front while
# (new dts_usec - dts_usec of the oldest queued packet) > max_time. Purging only happens with more than two queued
# keyframes; a purge removes the oldest packet and, if it was a keyframe, everything up to the next video keyframe.
reset
output rb
venc h264 bitrate=2500 extra=0a0b
set int max_time_sec 2
create replay_buffer
start
pkt v pts=0 key=1 size=10
pkt v pts=500 key=0 size=10
pkt v pts=1000 key=1 size=10
pkt v pts=1500 key=0 size=10
pkt v pts=2000 key=1 size=10
state_rb
echo three_keyframes_queued_so_the_2500ms_packet_purges_the_first_group
pkt v pts=2500 key=0 size=10
queue
state_rb
echo only_two_keyframes_left_so_nothing_is_purged_although_3600_minus_1000_is_over_2s
pkt v pts=3600 key=1 size=10
queue
state_rb
