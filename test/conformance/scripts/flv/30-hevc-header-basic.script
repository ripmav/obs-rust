# S-021 obs_parse_hevc_header: Annex-B HEVC parameter sets (VPS=32, SPS=33, PPS=34, SEI=39/40) in,
# HEVCDecoderConfigurationRecord (hvcC) out. Output layout (bytes):
#   01 | space<<6|tier<<5|profile_idc | compat flags u32 | constraint flags 6 bytes | level_idc |
#   0xf000|min_spatial_segmentation u16 | 0xfc|parallelismType | 0xfc|chromaFormat |
#   0xf8|bitDepthLumaMinus8 | 0xf8|bitDepthChromaMinus8 | avgFrameRate u16 = 0 |
#   constantFrameRate(0)<<6 | numTemporalLayers<<3 | temporalIdNested<<2 | 3 | numOfArrays |
#   per non-empty array in the order VPS, SPS, PPS, SEI prefix, SEI suffix:
#     completeness<<7 | nal_unit_type, count u16, then (length u16, NAL bytes incl. its 2-byte header)*
# The NAL bytes are copied verbatim (emulation-prevention bytes stay); only the parsed copy is unescaped.
# Parameter sets are built from the bit fields described in each comment.
echo "main-profile-8-bit-4:2:0-1080p-level-4.0 (VPS+SPS+PPS, 4-byte start codes)"
# profile 1, compat 0x60000000, constraint 0x900000000000, level 120, no VUI
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c0718180
echo "same-with-3-byte-start-codes-and-mixed"
# 3-byte start codes
hevc_header 00000140010c01ffff01600000030090000003000003007895d4000001420101016000000300900000030000030078a003c08010e5e5749249a90000014401c0718180
# alternating 4/3-byte start codes
hevc_header 0000000140010c01ffff01600000030090000003000003007895d4000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c0718180
echo "order-of-NALs-does-not-matter-arrays-are-fixed-VPS-SPS-PPS"
# PPS, SPS, VPS
hevc_header 000000014401c071818000000001420101016000000300900000030000030078a003c08010e5e5749249a90000000140010c01ffff01600000030090000003000003007895d4
# SPS, PPS, VPS
hevc_header 00000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c07181800000000140010c01ffff01600000030090000003000003007895d4
echo "main10"
# profile 2, compat 0x20000000, level 153, luma/chroma bit depth 10 (bitDepth-8 = 2)
hevc_header 0000000140010c01ffff02200000030090000003000003009995d400000001420101022000000300900000030000030099a003c08010e4de5749249a90000000014401c0718180
# luma 8 bit, chroma 10 bit
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5795d24926a40000000014401c0718180
# 12 bit
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e452e5749249a9000000014401c0718180
# bitDepth-8 = 8 (16 bit)
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e4244e5749249a90000000014401c0718180
# bitDepth-8 = 255 -> stored in 8 bits
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e401000080e5749249a9000000014401c0718180
echo "chroma-format-idc"
# chroma_format_idc 0
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078c00f0200439795d24926a4000000014401c0718180
# chroma_format_idc 1
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c0718180
# chroma_format_idc 2
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078b003c08010e5e5749249a9000000014401c0718180
# chroma_format_idc 3 (separate_colour_plane_flag present)
hevc_header 0000000140010c01ffff01600000030090000003000003007895d40000000142010101600000030090000003000003007890007810021cbcae92493520000000014401c0718180
# chroma_format_idc 5 -> stored as 5|0xfc
hevc_header 0000000140010c01ffff01600000030090000003000003007895d4000000014201010160000003009000000300000300789800f0200439795d24926a40000000014401c0718180
echo "conformance-window-and-picture-size"
# conformance_window_flag with offsets
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e7cbe5749249a9000000014401c0718180
# 8K size
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a000f008004385e5749249a9000000014401c0718180
echo "extra-NALs-are-ignored"
# AUD (35) and IDR slice (19) between the parameter sets
hevc_header 000000014601500000000140010c01ffff01600000030090000003000003007895d4000000012601af000000000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c07181800000000102010102
