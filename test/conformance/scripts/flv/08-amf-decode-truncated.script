# S-021 truncated AMF0 input: every prefix of a well-formed value is decoded with
# bDecodeName=0 (anonymous) so that each length from 0 to len-1 is exercised.
# The input is placed directly before an inaccessible page. Where the reference reads length
# fields before checking that they are present it crashes ("crash" line, DEFECT D-4): the required
# behaviour is a clean failure (ret=-1). Other prefixes show the reference's ordinary error returns
# and QUIRK Q-4 (ECMA array marker with fewer than 4 bytes behind it reports more bytes consumed
# than were supplied).
echo prefixes-of-num
decode - 0
decode 00 0
decode 003f 0
decode 003ff0 0
decode 003ff000 0
decode 003ff00000 0
decode 003ff0000000 0
decode 003ff000000000 0
decode 003ff00000000000 0
decode 003ff0000000000000 0
