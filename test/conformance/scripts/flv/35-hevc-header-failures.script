# S-021 failure paths of obs_parse_hevc_header. In the reference every failure after the NAL
# units were split ends in the cleanup path that returns the number of bytes collected so far
# (a NON-ZERO value) while *header is left untouched (DEFECT D-7: the caller would use an
# uninitialised pointer). REQUIRED behaviour: return 0 and set no header. The runner pre-sets *header
# to a sentinel and prints "header=unset" when it is unchanged; the vectors record the reference.
# A conforming implementation prints "ret=0 header=unset" for every case marked D-7.
echo "D-7-missing-parameter-sets"
# no VPS
hevc_header 00000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c0718180
# no SPS
hevc_header 0000000140010c01ffff01600000030090000003000003007895d4000000014401c0718180
# no PPS
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249a9
# only SEI
hevc_header 000000014e010505616263646580
# only an IDR slice
hevc_header 000000012601af00000300
# 17 VPS (more than the maximum)
hevc_header 
# 17 SPS
hevc_header 
# 65 PPS
hevc_header 
echo "D-7-SPS-that-cannot-be-parsed"
# num_short_term_ref_pic_sets = 65
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e57492498085b6db6db6db6db6db6db6db6db6db6db6db6db6db6db6db6da4000000014401c0718180
# num_long_term_ref_pics_sps = 32
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249b0421194e95b5f19d6f9df7e1194e95b5f19d6f9df7f20000000014401c0718180
# inter RPS flag on the first set is not read; rps_idx >= num_rps is impossible via the API
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e57492498083b6db6db6db6db6db6db6db6db6db6db6db6db6db6db6db6d20000000014401c0718180
# cpb_cnt_minus1 = 32 in the HRD of the VUI does not fail the whole header (return value of skip_hrd ignored)
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249aa010000030001000003001e40086052610084000000014401c0718180
echo "start-code-edge-cases"
# empty NAL between two start codes
hevc_header 000000010000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249a9000000014401c0718180
# size 5: start code then one byte -> too short for the 6 byte minimum
hevc_header 0000000140
# size 6: start code then two bytes -> no parameter sets
hevc_header 000000014001
# 3-byte start code then 2 bytes (size 5)
hevc_header 0000014001
