# S-021 exhaustive capacity sweeps for AMF container encoding (the boundary behaviour of the
# "outend" checks is part of the contract: see rules S-021-R12..R15). The object has three
# properties (width number, stereo bool, name string "abc"): 42 bytes as object, 46 as ECMA array,
# 43 as strict array when everything fits.
obj flat
add flat width number 1920
add flat stereo bool 1
add flat name string abc
echo sweep-object
cap 0
enc_obj flat object
