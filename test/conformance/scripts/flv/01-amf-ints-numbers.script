# S-021 AMF0 fixed-width integers, booleans and numbers (encode and decode).
# Integers are big-endian; the encoders take C 'short'/'int' (two's complement truncation).
cap 4096
enc_int16 0
enc_int16 1
enc_int16 0x1234
enc_int16 -1
enc_int16 0x12345
enc_int24 0x123456
enc_int24 -1
enc_int24 0x1ffffff
enc_int32 0x12345678
enc_int32 -2
enc_int32 0x7fffffff
enc_int32 0x80000000
dec_int16 0000
dec_int16 ffff
dec_int16 8001
dec_int24 010203
dec_int24 ffffff
dec_int32 01020304
dec_int32 ffffffff
dec_int32 80000000
# Number: type byte 00 then the IEEE-754 double, big endian
enc_number 0
enc_number 1
enc_number -1
enc_number 1.5
enc_number 3.14159265358979
enc_number 1920
enc_number 1e308
enc_number 5e-324
enc_number -0
enc_number inf
enc_number -inf
enc_number nan
enc_number bits:7ff8000000000001
enc_number bits:fff8000000000000
enc_number 0.1
dec_number 3ff0000000000000
dec_number bff0000000000000
dec_number 0000000000000000
dec_number 8000000000000000
dec_number 7ff0000000000000
dec_number fff0000000000000
dec_number 7ff8000000000000
dec_number 7ff0000000000001
dec_number 3fb999999999999a
dec_number 0000000000000001
# Boolean: type byte 01 then 00/01; any non-zero C int encodes as 01; decode: any non-zero byte is true
enc_bool 0
enc_bool 1
enc_bool 2
enc_bool -1
dec_bool 00
dec_bool 01
dec_bool 02
dec_bool ff
