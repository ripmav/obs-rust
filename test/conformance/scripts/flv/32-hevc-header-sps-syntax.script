# S-021 SPS syntax elements that obs_parse_hevc_header must walk through to reach the VUI and
# its min_spatial_segmentation_idc (the only later field of the SPS that is used) and the
# elements that carry numbers into the record. The decoder reads the SPS in exactly this order
# (all after the profile_tier_level): see spec section 6.4.
echo "vui-minimum-spatial-segmentation"
# bitstream_restriction min_spatial_segmentation_idc = 0
hevc_header 0000000140010c01ffff01600000030090000003000003007895d400000001420101016000000300900000030000030078a003c08010e5e5749249aa008a610084000000014401c0718180
