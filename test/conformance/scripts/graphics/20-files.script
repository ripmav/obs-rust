# *_create_from_file helpers read a whole file (os_quick_read_utf8_file, replaced by a virtual file
# table in this harness) and forward text + file name to the creation functions.
trace 0
gs_create g
gs_enter_context g
trace 1
file "a.vs" "VS-CONTENT"
file "a.ps" "PS-CONTENT"
gs_vertexshader_create_from_file "a.vs" > v
gs_pixelshader_create_from_file "a.ps" > p
echo == missing file -> error log, NULL, backend not called
gs_vertexshader_create_from_file "none.vs"
gs_pixelshader_create_from_file "none.ps"
gs_effect_create_from_file "none.effect"
echo == NULL file name
gs_vertexshader_create_from_file -
gs_pixelshader_create_from_file -
gs_effect_create_from_file -
echo == textures from file: decoded image data goes to a 1-level texture with flags 0; failures give NULL
gs_texture_create_from_file "3x2"
gs_texture_create_from_file "bogus"
echo == image decoder only produces RGBA here; creation failure at the backend
fail device_texture_create 1
gs_texture_create_from_file "3x2"
