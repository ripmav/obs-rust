# graphics-ffmpeg.c ffmpeg_image_reformat_frame / ffmpeg_image_orient on fabricated decoded frames. The frame
# metadata entry "Orientation" selects one of the EXIF orientations 1..8 (0 and 1 = untouched; values above 8
# are outside the contract: the reference then leaves most of the output buffer uninitialised, so they are not tested). Orientations 5..8 swap width and height. The
# reference only reaches this code when the decoder reports the entry as metadata (FFmpeg < 7.1 does; the
# FFmpeg installed for the vectors reports a display matrix instead, so real-file vectors never rotate).
echo == orientation values 0..8 on a 3x2 image, pixel i = bytes (i, 16+i, 32+i, ff)
reformat bgr0 3 2 12 0 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 1 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 2 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 3 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 4 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 5 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 6 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 7 straight 001020ff011121ff021222ff031323ff041424ff051525ff
reformat bgr0 3 2 12 8 straight 001020ff011121ff021222ff031323ff041424ff051525ff
echo == orientation on a 4x3 image (non-square, odd tile edges)
reformat rgba 4 3 16 2 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 3 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 4 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 5 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 6 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 7 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
reformat rgba 4 3 16 8 straight 001020ff011121ff021222ff031323ff041424ff051525ff061626ff071727ff081828ff091929ff0a1a2aff0b1b2bff
echo == 70x3 image rotated (tile size boundary)
reformat bgr0 70 3 280 6 straight 
reformat bgr0 70 3 280 5 straight 
