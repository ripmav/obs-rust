# os_generate_formatted_filename: tokens that read the video settings: %FPS %CRES %ORES %VF.
# %FPS is fps_num alone when fps_den <= 1, else fps_num/fps_den with two decimals.
# %CRES = base (canvas) size, %ORES = output size, %VF = output pixel format name.
now 1704164645
tz UTC0
video 60 1 1920 1080 1280 720 NV12
fname @null 1 "%FPS"
fname @null 1 "%CRES"
fname @null 1 "%ORES"
fname @null 1 "%VF"
fname mkv 1 "%CCYY-%MM-%DD %hh-%mm-%ss %FPS %CRES %ORES %VF"
fname mkv 0 "%CCYY-%MM-%DD %hh-%mm-%ss %FPS %CRES %ORES %VF"
video 30000 1001 1920 1080 1920 1080 I420
fname @null 1 "%FPS %VF"
video 24000 1001 3840 2160 1920 1080 BGRA
fname @null 1 "%FPS %CRES %ORES %VF"
video 25 1 1280 720 1280 720 I444
fname @null 1 "%FPS"
video 5 2 1 1 1 1 NV12
fname @null 1 "%FPS %CRES"
video 30 0 800 600 640 480 NV12
fname @null 1 "%FPS"
video 0 0 0 0 0 0 NONE
fname @null 1 "%FPS|%CRES|%ORES|%VF"
video 1 3 800 600 640 480 NV12
fname @null 1 "%FPS"
video 100 3 800 600 640 480 NV12
fname @null 1 "%FPS"
video 4294967295 1 4294967295 4294967295 4294967295 4294967295 NV12
fname @null 1 "%FPS %CRES %ORES"
