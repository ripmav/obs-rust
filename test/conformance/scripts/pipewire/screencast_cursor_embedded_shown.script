# EMBEDDED cursor mode requested when ShowCursor (default true) and no METADATA mode; version 4 -> persist_mode 2, empty token omitted.
unique_name :1.1
prop ScreenCast AvailableSourceTypes "uint32 1"
prop ScreenCast AvailableCursorModes "uint32 3"
prop ScreenCast version "uint32 4"
screencast_load
new m pipewire-desktop-capture-source
response 1 "(0, {'session_handle': <'/s/m'>})"
