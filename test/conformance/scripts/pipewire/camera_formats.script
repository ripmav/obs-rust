# Camera format / framerate lists and controls. A device advertises EnumFormat params (raw formats the plugin knows; unknown
# formats and non-raw subtypes are skipped) and PropInfo params (controls). Selecting a device fills the "format" list with
# "WxH (aspect) - fps list FPS - FORMAT" entries (JSON payload per entry) and rebuilds the "controls" group.
unique_name :1.8
camera_load
new cam pipewire-camera-source
response 1 "(0, {})"
finish 2 fd
registry_global 50 PipeWire:Interface:Node 3 node.name=cam0 "node.description=Front Camera" media.class=Video/Source
node_info 50 3:2 1:2
pod_enum_format f1 raw YUY2 1280 720 enum:30/1,30/1,15/1
pod_enum_format f2 raw NV12 1920 1080 none:60/1
pod_enum_format f3 mjpg - 1920 1080 enum:30/1,30/1
pod_enum_format f4 raw I420 640 480 none:30/1
pod_enum_format f5 raw BGRx 800 600 range:30/1,1/1,60/1
pod_enum_format f6 raw RGBA 1000 625 enum:30000/1001,30000/1001,25/1
pod_enum_format f7 raw BGRA 1024 768 step:30/1,1/1,60/1
pod_enum_format f8 raw RGBx 720 1280 int:30
pod_enum_format f9 raw YUY2 1440 900 omit
pod_enum_format f10 raw NV12 1200 1000 none:10/1
pod_enum_format f11 raw NV12 1280 800 none:10/1 sizerange
pod_prop_info c1 0x20001 Brightness int range - 128 0 255 1
pod_prop_info c2 0x20002 AutoMode bool none - 1
pod_prop_info c3 0x20007 Gain float range - 1.5 0 10
pod_prop_info c4 0x20003 "Power Line" int enum "0:Disabled,1:50 Hz,2:60 Hz" 1 0 1 2
pod_prop_info c5 0x20004 Hue int enum - 1 0 1
pod_prop_info c6 0x20005 Zoom int none - 5
pod_prop_info c7 0x20006 Saturation int step - 100 0 200 5
pod_prop_info c8 0x20008 Sharpness float step - 1 0 4 0.5
pod_prop_info c9 0x20009 Weird int enum - 1 0 1
pod_enum_format f12 raw NV12 1366 768 none:30/1
pod_enum_format f13 raw NV12 479 640 none:30/1
pod_enum_format f14 raw NV12 720 1280 none:30/1
node_param 50 async:1 3 f1
node_param 50 async:1 3 f2
node_param 50 async:1 3 f3
node_param 50 async:1 3 f4
node_param 50 async:1 3 f5
node_param 50 async:1 3 f6
node_param 50 async:1 3 f7
node_param 50 async:1 3 f8
node_param 50 async:1 3 f9
node_param 50 async:1 3 f10
node_param 50 async:1 3 f11
node_param 50 async:1 1 c1
node_param 50 async:1 1 c2
node_param 50 async:1 1 c3
node_param 50 async:1 1 c4
node_param 50 async:1 1 c5
node_param 50 async:1 1 c6
node_param 50 async:1 1 c7
node_param 50 async:1 1 c8
node_param 50 async:1 3 f12
node_param 50 async:1 3 f13
node_param 50 async:1 3 f14
proxy_done 50 3
props cam
set cam device_id str cam0
modified cam device_id
dump cam
