# obs_pw_video_format_from_spa_format: the supported-format table (SPA id -> DRM fourcc, GS format, OBS video format,
# red/blue swizzle flag, bytes per pixel, pretty name) and rejection of everything else (ids not in the table, UNKNOWN, ENCODED).
format BGRA
format RGBA
format BGRx
format RGBx
format YUY2
format NV12
format ABGR_210LE
format xBGR_210LE
format I420
format ARGB
format UNKNOWN
format ENCODED
format 99999
# the out parameter is optional
format_null BGRA
format_null I420
