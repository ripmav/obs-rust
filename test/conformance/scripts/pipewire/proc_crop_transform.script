# VideoCrop and VideoTransform metadata: effective crop (non-zero origin or smaller than the frame) restricts the drawn region
# and the reported size; transforms 90/270 swap width and height; flipped variants set the sprite flip flag; rotations push a
# rotation matrix with a size-dependent translation. A crop region with zero extent, or one equal to the full frame, is ignored.
unique_name :1.5
prop ScreenCast AvailableSourceTypes "uint32 1"
prop ScreenCast version "uint32 2"
screencast_load
new a pipewire-desktop-capture-source
portal_ok 53
param_changed format=BGRx size=100x50
buf_data 0 0 memptr 0 0 400 5000 0 0x10
buf_meta 0 crop 10 20 30 40
buf_meta 0 transform 0
buf_push 0
process
size a
render a
# no effective crop: region equal to the frame
buf_data 1 0 memptr 0 0 400 5000 0 0x10
buf_meta 1 crop 0 0 100 50
buf_push 1
process
size a
render a
# zero-extent region is invalid
buf_data 2 0 memptr 0 0 400 5000 0 0x10
buf_meta 2 crop 5 5 0 40
buf_push 2
process
size a
# transform 1
buf_data 11 0 memptr 0 0 400 5000 0 0x10
buf_meta 11 crop 10 20 30 40
buf_meta 11 transform 1
buf_push 11
process
size a
render a
# transform 2
buf_data 12 0 memptr 0 0 400 5000 0 0x10
buf_meta 12 crop 10 20 30 40
buf_meta 12 transform 2
buf_push 12
process
size a
render a
# transform 3
buf_data 13 0 memptr 0 0 400 5000 0 0x10
buf_meta 13 crop 10 20 30 40
buf_meta 13 transform 3
buf_push 13
process
size a
render a
# transform 4
buf_data 14 0 memptr 0 0 400 5000 0 0x10
buf_meta 14 crop 10 20 30 40
buf_meta 14 transform 4
buf_push 14
process
size a
render a
# transform 5
buf_data 15 0 memptr 0 0 400 5000 0 0x10
buf_meta 15 crop 10 20 30 40
buf_meta 15 transform 5
buf_push 15
process
size a
render a
# transform 6
buf_data 16 0 memptr 0 0 400 5000 0 0x10
buf_meta 16 crop 10 20 30 40
buf_meta 16 transform 6
buf_push 16
process
size a
render a
# transform 7
buf_data 17 0 memptr 0 0 400 5000 0 0x10
buf_meta 17 crop 10 20 30 40
buf_meta 17 transform 7
buf_push 17
process
size a
render a
# rotation without crop uses the full frame size for the translation
buf_data 20 0 memptr 0 0 400 5000 0 0x10
buf_meta 20 transform 2
buf_push 20
process
size a
render a
