# Import failure of a DMA-BUF (graphics backend rejects the modifier): the failing modifier is removed from that format's
# list and a renegotiation event is signalled; running the event re-publishes the format params without it.
unique_name :1.5
prop ScreenCast AvailableSourceTypes "uint32 1"
prop ScreenCast version "uint32 2"
screencast_load
gs_dmabuf 1 ARGB8888
gs_modifiers ARGB8888 0x0 0x7 0x9
pw_server_version 1.2.0
new a pipewire-desktop-capture-source
portal_ok 45
dmabuf_import fail
param_changed format=BGRA size=64x64 modifier=0x7
buf_data 0 0 dmabuf 11 0 256 100 0 0
buf_push 0
process
run_events
leaks
