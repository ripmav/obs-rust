# Camera portal discovery: creating a camera source asks the Camera portal for access (AccessCamera request), then opens the
# PipeWire remote with OpenPipeWireRemote (no session), connects with a registry listener and does a core roundtrip.
# Registry globals of type Node become devices; their EnumFormat/PropInfo params are enumerated and committed when the
# proxy "done" event for the pending sync arrives.
unique_name :1.8
camera_load
new cam pipewire-camera-source
response 1 "(0, {})"
finish 2 fd
registry_global 50 PipeWire:Interface:Node 3 node.name=cam0 "node.description=Front Camera" media.class=Video/Source
node_info 50 3:2 1:2
pod_enum_format f1 raw YUY2 1280 720 enum:30/1,30/1,15/1
pod_enum_format f2 raw NV12 1920 1080 none:60/1
node_param 50 async:1 3 f1
node_param 50 async:1 3 f2
proxy_done 50 3
props cam
set cam device_id str cam0
modified cam device_id
