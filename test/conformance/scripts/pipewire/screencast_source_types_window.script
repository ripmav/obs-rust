# Window-only portal: only the window source and the unified source exist. The window source requests types=2.
unique_name :1.1
prop ScreenCast AvailableSourceTypes "uint32 2"
prop ScreenCast AvailableCursorModes "uint32 2"
prop ScreenCast version "uint32 3"
screencast_load
new w pipewire-window-capture-source
name w
response 1 "(0, {'session_handle': <'/s/w'>})"
