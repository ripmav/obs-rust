# Source creation from stored settings: the "format" JSON (or the legacy pixelformat+resolution pair, which is converted and
# written back as "format"), the "framerate" JSON; unparsable values leave the corresponding selection unset.
unique_name :1.8
camera_load
set a device_id str camX
set a pixelformat int 4
set a resolution str "{\"width\":640,\"height\":480}"
new a pipewire-camera-source
settings_json a
set b device_id str camX
set b pixelformat int 99999
set b resolution str "{\"width\":640,\"height\":480}"
new b pipewire-camera-source
settings_json b
set c device_id str camX
set c pixelformat int 4
new c pipewire-camera-source
settings_json c
set d device_id str camX
set d format str "{\"encoded\":true,\"video_format\":131074}"
new d pipewire-camera-source
set e device_id str camX
set e format str "{\"encoded\":false,\"video_format\":99999}"
new e pipewire-camera-source
set f device_id str camX
set f format str "not json"
new f pipewire-camera-source
get a device_id str
