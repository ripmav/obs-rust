# Source audio that stops with a partial buffer: after two identical buffer sizes ("pending stop trick") the leftover data is cleared and audio_ts reset to 0.
init 48000 2
clock 1000000000
timeline 1000000000
source a input
video_mix 1
channel 0 0 a
set a active 1
output a 48000 2 1500 1000000000 const 0.25
run 6 1
state a
