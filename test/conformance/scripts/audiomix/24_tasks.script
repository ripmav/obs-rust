# Queued audio tasks run at the end of audio_callback only when the call returns true (not while buffering).
init 48000 2
clock 1000000000
timeline 1000000000
source a input
video_mix 1
channel 0 0 a
set a active 1
output a 48000 2 1024 970000000 const 0.25
output a 48000 2 1024 991333333 const 0.25
output a 48000 2 1024 1012666666 const 0.25
output a 48000 2 1024 1034000000 const 0.25
task first
task second
run 4 1
task third
run 1 1
