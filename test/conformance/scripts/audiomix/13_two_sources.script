# Two sources summed; second source only on mix 1.
init 48000 2
clock 1000000000
timeline 1000000000
source a input
source b input
video_mix 1
channel 0 0 a
channel 0 1 b
set a active 1
set b active 1
set b mixers 2
output a 48000 2 1024 1000000000 const 0.25
output b 48000 2 1024 1000000000 const 0.5
run 1 3
run 0 3
