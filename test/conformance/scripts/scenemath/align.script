# Alignment flags (LEFT=1 RIGHT=2 TOP=4 BOTTOM=8, none=center) move the origin by size/2 or size; the half uses
# integer division of the (truncated) pixel size. Odd source sizes expose the truncation. Source 101x51.
source odd 101 51
scene main
add main odd c
echo -- 9 alignments, scale 1, pos 0,0: look at draw translation (negative origin) and box translation
align c 5
pos c 0 0
print c
align c 4
print c
align c 6
print c
align c 1
print c
align c 0
print c
align c 2
print c
align c 9
print c
align c 8
print c
align c 10
print c
echo -- both LEFT and RIGHT set: RIGHT wins; both TOP and BOTTOM: BOTTOM wins
align c 3
print c
align c 12
print c
echo -- scaled by 1.5: size is truncated to whole pixels before halving
align c 0
scale c 1.5 1.5
print c
