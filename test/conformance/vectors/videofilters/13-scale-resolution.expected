echo case 1 resolution=[None]
call samplerstate_create s1 filter=POINT u=CLAMP v=CLAMP w=CLAMP aniso=0 border=0
create f1 -> ok
tick f1 0.016
size f1 width=1920 height=1080
render f1
call skip_video_filter f1
echo case 2 resolution=[Base.Canvas]
call samplerstate_create s2 filter=POINT u=CLAMP v=CLAMP w=CLAMP aniso=0 border=0
create f2 -> ok
call get_param base:bicubic_scale:image -> ok
call get_param base:bicubic_scale:base_dimension -> ok
call get_param base:bicubic_scale:base_dimension_i -> ok
call get_param base:bicubic_scale:undistort_factor -> ok
call get_param base:bicubic_scale:multiplier -> ok
tick f2 0.016
size f2 width=2560 height=1440
render f2
call filter_begin_cs f2 format=RGBA space=SRGB allow=NO_DIRECT -> 1
call set_vec2 base:bicubic_scale:base_dimension 1920 1080
call set_vec2 base:bicubic_scale:base_dimension_i 0.00052083336 0.00092592591
call set_float base:bicubic_scale:undistort_factor 1
call set_float base:bicubic_scale:multiplier 1
call blend_push
call blend_function ONE INVSRCALPHA
call filter_tech_end f2 base:bicubic_scale size=2560x1440 technique=Draw exists=1
call blend_pop
