call get_param e1:spill -> ok
create a -> ok
render a
call filter_begin a format=RGBA allow=ALLOW_DIRECT -> 1
call set_vec4 e1:color 1 1 1 1
call set_float e1:contrast 1
call set_float e1:brightness 0
call set_float e1:gamma 1
call set_vec2 e1:chroma_key 0.163388997 0.103018999
call set_vec2 e1:pixel_size 0.000781250012 0.00138888892
call set_float e1:similarity 0.400000006
call set_float e1:smoothness 0.0799999982
call set_float e1:spill 0.100000001
call filter_end a e1 size=0x0
