call effect_create file=color_key_filter.effect -> e1 uniforms=9 techniques=1
call get_param e1:color -> ok
call get_param e1:contrast -> ok
call get_param e1:brightness -> ok
call get_param e1:gamma -> ok
call get_param e1:key_color -> ok
call get_param e1:similarity -> ok
call get_param e1:smoothness -> ok
create a -> ok
render a
call filter_begin a format=RGBA allow=ALLOW_DIRECT -> 1
call set_vec4 e1:color 1 1 1 1
call set_float e1:contrast 1
call set_float e1:brightness 0
call set_float e1:gamma 1
call set_vec4 e1:key_color 0 1 0 1
call set_float e1:similarity 0.0799999982
call set_float e1:smoothness 0.0500000007
call filter_end a e1 size=0x0
call effect_create file=color_key_filter_v2.effect -> e2 uniforms=9 techniques=1
call get_param e2:opacity -> ok
call get_param e2:contrast -> ok
call get_param e2:brightness -> ok
call get_param e2:gamma -> ok
call get_param e2:key_color -> ok
call get_param e2:similarity -> ok
call get_param e2:smoothness -> ok
create b -> ok
render b
call filter_begin_cs b format=RGBA space=SRGB allow=ALLOW_DIRECT -> 1
call set_float e2:opacity 1
call set_float e2:contrast 1
call set_float e2:brightness 0
call set_float e2:gamma 1
call set_vec4 e2:key_color 0 1 0 1
call set_float e2:similarity 0.0799999982
call set_float e2:smoothness 0.0500000007
call blend_push
call blend_function ONE INVSRCALPHA
call filter_end b e2 size=0x0
call blend_pop
