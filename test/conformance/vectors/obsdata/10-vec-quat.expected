dump a {v2:object[user={x:number[user=num(D,1,1.5)],y:number[user=num(D,-2,-2.25)]}],v3:object[user={x:number[user=num(D,1,1)],y:number[user=num(D,2,2)],z:number[user=num(D,3,3)]}],v4:object[user={x:number[user=num(D,1,1)],y:number[user=num(D,2,2)],z:number[user=num(D,3,3)],w:number[user=num(D,4,4)]}],q:object[user={x:number[user=num(D,0,0.5)],y:number[user=num(D,0,0.5)],z:number[user=num(D,0,0.5)],w:number[user=num(D,0,0.5)]}]}
