a_push ar 0
refs e1 2
a_item ar 0 ok
refs e1 3
same e1 e1b 1
a_item ar 0 ok
refs e1c 2
a_count ar 0
echo --- destroying a container destroys children (no leak under a sanitizer)
dump deep {child:object[user={child:object[user={v:number[user=num(I,1,1)]}]}]}
