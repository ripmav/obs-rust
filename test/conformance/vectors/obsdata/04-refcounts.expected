echo --- the caller may drop its handle; the container keeps the object alive
get_obj a sub ok
refs o3 2
dump a {sub:object[user={x:number[user=num(I,1,1)]}]}
echo --- replacing a value releases the old object
refs o3 1
refs p 2
refs p 2
