from_json_file c fail
from_json_file c ok
json c "{\"k\":1}"
from_json_file d ok
dump d {}
echo --- safe loader: good primary file ignores the backup
from_json_file_safe f ok
json f "{\"from\":\"primary\"}"
exists p.json.bak 1
echo --- safe loader: corrupt primary uses the backup, and the backup file is consumed
log error obs-data.c: [obs_data_create_from_json] Failed reading json string (1): string or '}' expected near 'corrupt'
log warning obs-data.c: [obs_data_create_from_json_file_safe] attempting backup file
from_json_file_safe g ok
json g "{\"from\":\"backup\"}"
exists p.json.bak 0
file p.json "{\"from\":\"backup\"}"
echo --- safe loader: missing primary also falls back
log warning obs-data.c: [obs_data_create_from_json_file_safe] attempting backup file
from_json_file_safe h ok
json h "{\"from\":\"backup2\"}"
exists p.json 1
echo --- safe loader: corrupt backup too, or no backup, or no extension
