save_json_pretty_safe 1
file pretty.json "{\n    \"s\": \"text\",\n    \"i\": 1\n}"
exists pretty.json.tmp 0
echo --- safe save with backup
save_json_safe 1
file conf.json "{\"s\":\"text\",\"i\":2}"
file conf.json.bak "{\"s\":\"text\",\"i\":1}"
exists conf.json.tmp 0
save_json_safe 1
file conf.json "{\"s\":\"text\",\"i\":3}"
file conf.json.bak "{\"s\":\"text\",\"i\":2}"
echo --- invalid temp extension
log error os_quick_write_utf8_file_safe: invalid temporary extension specified
save_json_safe 0
log error os_quick_write_utf8_file_safe: invalid temporary extension specified
save_json_safe 0
file conf.json "{\"s\":\"text\",\"i\":3}"
echo --- empty data is written as {}
save_json 1
file empty.json "{}"
save_json 0
exists nothing.json 0
echo --- unwritable path
save_json 0
log error os_quick_write_utf8_file_safe: failed to write to obsdata-f-nodir/x/conf.json.tmp
save_json_safe 0
echo --- loading
from_json_file c fail
from_json_file c fail
