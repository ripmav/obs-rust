  text "uniform float2 base_dimension;\nuniform float4x4 ViewProj;\n\n\nstruct VertOut {\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 pos : POSITION;\n};\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertOut VSDefault(VertData v_in)\n{\n\tVertOut vert_out;\n\tvert_out.uv = v_in.uv * base_dimension;\n\tvert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);\n\treturn vert_out;\n}\n\nVertOut main(VertData v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
