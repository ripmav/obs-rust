backend vertexshader_create location="basic.effect (Vertex shader, technique Draw, pass 0)" len=294 fnv=449fcdd65dad02a1
  text "uniform float4x4 ViewProj;\n\n\nstruct VOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nstruct VIn {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVOut VS(VIn v)\n{ VOut o; o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); o.uv = v.uv; return o; }\n\nVOut main(VIn v)\n{\n\treturn VS(v);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  result ok
backend pixelshader_create location="basic.effect (Pixel shader, technique Draw, pass 0)" len=281 fnv=4d2edafbcedd2425
  text "uniform texture2d image;\n\n\nsampler_state samp {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\nstruct VOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nfloat4 PS(VOut v)\n{ return image.Sample(samp, v.uv); }\n\nfloat4 main(VOut v) : TARGET\n{\n\treturn PS(v);\n}\n"
  sparam 0 name=image type=TEXTURE array=0
  result ok
