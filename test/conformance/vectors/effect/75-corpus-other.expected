backend vertexshader_create location="plugins/text-freetype2/data/text_default.effect (Vertex shader, technique Draw, pass 0)" len=453 fnv=4b1f2054fa8895e6
  text "uniform float4x4 ViewProj;\nuniform bool use_color;\n\n\nstruct VertInOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 col : COLOR;\n};\n\nVertInOut VSDefault(VertInOut vert_in)\n{\n\tVertInOut vert_out;\n\tvert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = vert_in.uv;\n\tvert_out.col = use_color ? vert_in.col : float4(0.0, 0.0, 0.0, 1.0);\n\treturn vert_out;\n}\n\nVertInOut main(VertInOut vert_in)\n{\n\treturn VSDefault(vert_in);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  sparam 1 name=use_color type=BOOL array=0
  result ok
backend pixelshader_create location="plugins/text-freetype2/data/text_default.effect (Pixel shader, technique Draw, pass 0)" len=405 fnv=7eb14f477b93a496
  text "uniform texture2d image;\n\n\nsampler_state def_sampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\nstruct VertInOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 col : COLOR;\n};\n\nfloat4 PSDrawBare(VertInOut vert_in)\n{\n\tvert_in.col.a *= image.Sample(def_sampler, vert_in.uv).a;\n\treturn vert_in.col;\n}\n\nfloat4 main(VertInOut vert_in) : TARGET\n{\n\treturn PSDrawBare(vert_in);\n}\n"
  sparam 0 name=image type=TEXTURE array=0
  result ok
