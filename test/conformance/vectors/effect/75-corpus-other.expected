  text "uniform float4x4 ViewProj;\n\n\nstruct VertInOut {\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 pos : POSITION;\n};\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertInOut VSDefault(VertData v_in)\n{\n\tVertInOut v_out;\n\tv_out.uv = v_in.uv;\n\tv_out.pos = mul(float4(v_in.pos.xyz, 1.), ViewProj);\n\treturn v_out;\n}\n\nVertInOut main(VertData v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
