gba.rgb);\n\trgba.rgb = reinhard(rgba.rgb);\n\trgba.rgb = rec2020_to_rec709(rgba.rgb);\n\treturn rgba;\n}\n\nfloat4 main(FragData f_in) : TARGET\n{\n\treturn PSMaskMultiplyTonemap(f_in);\n}\n"
