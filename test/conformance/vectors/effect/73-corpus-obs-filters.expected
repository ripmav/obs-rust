  text "uniform float4x4 ViewProj;\nuniform float2 mul_val;\nuniform float2 add_val;\n\n\nstruct VertDataOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat2 uv2 : TEXCOORD1;\n};\n\nstruct VertDataIn {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertDataOut VSDefault(VertDataIn v_in)\n{\n\tVertDataOut vert_out;\n\tvert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = v_in.uv;\n\tvert_out.uv2 = v_in.uv * mul_val + add_val;\n\treturn vert_out;\n}\n\nVertDataOut main(VertDataIn v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
