backend vertexshader_create location="plugins/obs-filters/data/sharpness.effect (Vertex shader, technique Draw, pass 0)" len=822 fnv=f4a1ddffd41b4720
  text "uniform float4x4 ViewProj;\nuniform float texture_width;\nuniform float texture_height;\n\n\nstruct VertOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 t1 : TEXCOORD1;\n\tfloat4 t2 : TEXCOORD2;\n\tfloat4 t3 : TEXCOORD3;\n};\n\nstruct VertInOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertOut VSDefault(VertInOut vert_in)\n{\n\tVertOut vert_out;\n\tvert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = vert_in.uv;\n\n\tfloat2 ps = float2(1.0/texture_width, 1.0/texture_height);\n\tfloat dx = ps.x;\n\tfloat dy = ps.y;\n\n\tvert_out.t1 = vert_in.uv.xxxy + float4( -dx, 0, dx,    -dy);  \n\tvert_out.t2 = vert_in.uv.xxxy + float4( -dx, 0, dx,      0);  \n\tvert_out.t3 = vert_in.uv.xxxy + float4( -dx, 0, dx,     dy);  \n\treturn vert_out;\n}\n\nVertOut main(VertInOut vert_in)\n{\n\treturn VSDefault(vert_in);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  sparam 1 name=texture_width type=FLOAT array=0
  sparam 2 name=texture_height type=FLOAT array=0
  result ok
backend pixelshader_create location="plugins/obs-filters/data/sharpness.effect (Pixel shader, technique Draw, pass 0)" len=1119 fnv=f90c68eff3667e36
  text "uniform texture2d image;\nuniform float sharpness;\n\n\nsampler_state def_sampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\n\n\n\n\n\n\n\n\nstruct VertOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat4 t1 : TEXCOORD1;\n\tfloat4 t2 : TEXCOORD2;\n\tfloat4 t3 : TEXCOORD3;\n};\n\nfloat4 PSDrawBare(VertOut vert_in)\n{\n\tfloat4 E  = image.Sample(def_sampler, vert_in.uv);\n\n\tfloat4 color = 8*E;\n\tfloat4 B = image.Sample(def_sampler, vert_in.t1.yw);\n\tfloat4 D = image.Sample(def_sampler, vert_in.t2.xw);\n\tfloat4 F = image.Sample(def_sampler, vert_in.t2.zw);\n\tfloat4 H = image.Sample(def_sampler, vert_in.t3.yw);\n\tcolor -= image.Sample(def_sampler, vert_in.t1.xw);\n\tcolor -= B;\n\tcolor -= image.Sample(def_sampler, vert_in.t1.zw);\n\tcolor -= D;\n\tcolor -= F;\n\tcolor -= image.Sample(def_sampler, vert_in.t3.xw);\n\tcolor -= H;\n\tcolor -= image.Sample(def_sampler, vert_in.t3.zw);\n\n\tcolor = ( (distance(E,F) != 0.0 && distance(E,D) != 0.0) || (distance(E,B) != 0.0 && distance(E,H) != 0.0) ) ? saturate(E + color * sharpness) : E;\n\n\treturn color;\n}\n\nfloat4 main(VertOut vert_in) : TARGET\n{\n\treturn PSDrawBare(vert_in);\n}\n"
  sparam 0 name=image type=TEXTURE array=0
  sparam 1 name=sharpness type=FLOAT array=0
  result ok
