backend pixelshader_create location="plugins/obs-filters/data/mask_alpha_filter.effect (Pixel shader, technique Draw, pass 0)" len=628 fnv=83ad2747d96dd937
  text "uniform texture2d image;\nuniform float4 color;\nuniform texture2d target;\n\n\nsampler_state textureSampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\n\nstruct VertDataOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n\tfloat2 uv2 : TEXCOORD1;\n};\n\nfloat4 PSAlphaMaskRGBA(VertDataOut v_in)\n{\n\tfloat4 rgba = image.Sample(textureSampler, v_in.uv);\n\trgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;\n\trgba *= color;\n\n\tfloat4 targetRGB = target.Sample(textureSampler, v_in.uv2);\n\trgba.a *= targetRGB.a;\n\trgba.rgb *= rgba.a;\n\treturn rgba;\n}\n\nfloat4 main(VertDataOut v_in) : TARGET\n{\n\treturn PSAlphaMaskRGBA(v_in);\n}\n"
  sparam 0 name=image type=TEXTURE array=0
  sparam 1 name=color type=VEC4 array=0
  sparam 2 name=target type=TEXTURE array=0
  result ok
