  text "uniform float4x4 ViewProj;\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertData VSDefault(VertData v_in)\n{\n\tVertData vert_out;\n\tvert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = v_in.uv;\n\treturn vert_out;\n}\n\nVertData main(VertData v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  result ok
backend pixelshader_create location="plugins/obs-filters/data/color_key_filter_v2.effect (Pixel shader, technique Draw, pass 0)" len=1356 fnv=7b94464cc0790a20
  text "uniform texture2d image;\nuniform float opacity;\n\n\nsampler_state textureSampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nuniform float similarity;\nuniform float smoothness;\n\n\nuniform float4 key_color;\n\n\nfloat GetNonlinearChannel(float u)\n{\n\treturn (u <= 0.0031308) ? (12.92 * u) : ((1.055 * pow(u, 1.0 / 2.4)) - 0.055);\n}\n\n\nfloat3 GetNonlinearColor(float3 rgb)\n{\n\treturn float3(GetNonlinearChannel(rgb.r), GetNonlinearChannel(rgb.g), GetNonlinearChannel(rgb.b));\n}\n\n\nfloat GetColorDist(float3 rgb)\n{\n\treturn distance(key_color.rgb, GetNonlinearColor(rgb));\n}\n\n\nuniform float gamma;\nuniform float contrast;\nuniform float brightness;\n\n\nfloat4 CalcColor(float4 rgba)\n{\n\treturn float4(pow(rgba.rgb, float3(gamma, gamma, gamma)) * contrast + brightness, rgba.a);\n}\n\n\nfloat4 ProcessColorKey(float4 rgba, VertData v_in)\n{\n\tfloat colorDist = GetColorDist(rgba.rgb);\n\trgba.a *= saturate(max(colorDist - similarity, 0.0) / smoothness);\n\n\treturn CalcColor(rgba);\n}\n\n\nfloat4 PSColorKeyRGBA(VertData v_in)\n{\n\tfloat4 rgba = image.Sample(textureSampler, v_in.uv);\n\trgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;\n\trgba.a *= opacity;\n\trgba = ProcessColorKey(rgba, v_in);\n\trgba.rgb *= rgba.a;\n\treturn rgba;\n}\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSColorKeyRGBA(v_in);\n}\n"
  sparam 0 name=image type=TEXTURE array=0
  sparam 1 name=opacity type=FLOAT array=0
  sparam 2 name=similarity type=FLOAT array=0
  sparam 3 name=smoothness type=FLOAT array=0
  sparam 4 name=key_color type=VEC4 array=0
  sparam 5 name=gamma type=FLOAT array=0
  sparam 6 name=contrast type=FLOAT array=0
  sparam 7 name=brightness type=FLOAT array=0
  result ok
