exel,     1  * 2  , -1, field) + load_at(texel, -    1  * 2  , 1, field)).   a   / 2;  } } } }\n\n\tif (mode0) {\n\t\tfloat4 b =  ((load_at_prev(texel,  0 ,   2 ) + load_at_image(texel,  0 ,   2 ))/2),\n\t\t       f =  ((load_at_prev(texel,  0 ,   -2 ) + load_at_image(texel,  0 ,   -2 ))/2);\n\n\t\tfloat4 max_ = max(d - e, max(d - c, min(b - c, f - e))),\n\t\t       min_ = min(d - e, min(d - c, max(b - c, f - e)));\n\n\t\tdiff = max(diff, max(min_, -max_));\n\t} else {\n\t\tdiff = max(diff, max(min(d - e, d - c), -max(d - e, d - c)));\n\t}\n\n\n\n\t { \tif(spatial_pred. r  > d. r  + diff. r ) \t\tspatial_pred. r  = d. r  + diff. r ; \telse if(spatial_pred. r  < d. r  - diff. r ) \t\tspatial_pred. r  = d. r  - diff. r ; }\n\t { \tif(spatial_pred. g  > d. g  + diff. g ) \t\tspatial_pred. g  = d. g  + diff. g ; \telse if(spatial_pred. g  < d. g  - diff. g ) \t\tspatial_pred. g  = d. g  - diff. g ; }\n\t { \tif(spatial_pred. b  > d. b  + diff. b ) \t\tspatial_pred. b  = d. b  + diff. b ; \telse if(spatial_pred. b  < d. b  - diff. b ) \t\tspatial_pred. b  = d. b  - diff. b ; }\n\t { \tif(spatial_pred. a  > d. a  + diff. a ) \t\tspatial_pred. a  = d. a  + diff. a ; \telse if(spatial_pred. a  < d. a  - diff. a ) \t\tspatial_pred. a  = d. a  - diff. a ; }\n\n\treturn spatial_pred;\n}\n\n\nuniform float2 dimensions;\n\n\nint2 pixel_uv(float2 uv)\n{\n\treturn int2(uv * dimensions);\n}\n\n\nfloat4 PSYadifMode0RGBA(VertData v_in)\n{\n\treturn texel_at_yadif(pixel_uv(v_in.uv), field_order, true);\n}\n\n\nfloat3 rec709_to_rec2020(float3 v)\n{\n\tfloat r = dot(v, float3(0.62740389593469903, 0.32928303837788370, 0.043313065687417225));\n\tfloat g = dot(v, float3(0.069097289358232075, 0.91954039507545871, 0.011362315566309178));\n\tfloat b = dot(v, float3(0.016391438875150280, 0.088013307877225749, 0.89559525324762401));\n\treturn float3(r, g, b);\n}\n\n\nfloat srgb_nonlinear_to_linear_channel(float u)\n{\n\treturn (u <= 0.04045) ? (u / 12.92) : pow(mad(u, 1. / 1.055, .055 / 1.055), 2.4);\n}\n\n\nfloat3 srgb_nonlinear_to_linear(float3 v)\n{\n\treturn float3(srgb_nonlinear_to_linear_channel(v.r), srgb_nonlinear_to_linear_channel(v.g), srgb_nonlinear_to_linear_channel(v.b));\n}\n\n\nfloat3 reinhard(float3 rgb)\n{\n\trgb /= rgb + float3(1., 1., 1.);\n\trgb = saturate(rgb);\n\trgb = pow(rgb, float3(1. / 2.4, 1. / 2.4, 1. / 2.4));\n\trgb = srgb_nonlinear_to_linear(rgb);\n\treturn rgb;\n}\n\n\nfloat3 rec2020_to_rec709(float3 v)\n{\n\tfloat r = dot(v, float3(1.6604910021084345, -0.58764113878854951, -0.072849863319884883));\n\tfloat g = dot(v, float3(-0.12455047452159074, 1.1328998971259603, -0.0083494226043694768));\n\tfloat b = dot(v, float3(-0.018150763354905303, -0.10057889800800739, 1.1187296613629127));\n\treturn float3(r, g, b);\n}\n\n\nfloat4 PSYadifMode0RGBA_tonemap(VertData v_in)\n{ \tfloat4 rgba =  PSYadifMode0RGBA (v_in); \trgba.rgb = rec709_to_rec2020(rgba.rgb); \trgba.rgb = reinhard(rgba.rgb); \trgba.rgb = rec2020_to_rec709(rgba.rgb); \treturn rgba; }\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSYadifMode0RGBA_tonemap(v_in);\n}\n"
