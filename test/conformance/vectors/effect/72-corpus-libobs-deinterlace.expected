t3(-0.12455047452159074, 1.1328998971259603, -0.0083494226043694768));\n\tfloat b = dot(v, float3(-0.018150763354905303, -0.10057889800800739, 1.1187296613629127));\n\treturn float3(r, g, b);\n}\n\n\nfloat4 PSLinearRGBA_2x_multiply_tonemap(VertData v_in)\n{ \tfloat4 rgba =  PSLinearRGBA_2x (v_in); \trgba.rgb *= multiplier; \trgba.rgb = rec709_to_rec2020(rgba.rgb); \trgba.rgb = reinhard(rgba.rgb); \trgba.rgb = rec2020_to_rec709(rgba.rgb); \treturn rgba; }\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSLinearRGBA_2x_multiply_tonemap(v_in);\n}\n"
