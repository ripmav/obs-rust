=== libobs/data/deinterlace_blend.effect
backend vertexshader_create location="libobs/data/deinterlace_blend.effect (Vertex shader, technique Draw, pass 0)" len=317 fnv=b06d11de3e765c86
  text "uniform float4x4 ViewProj;\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertData VSDefault(VertData v_in)\n{\n\tVertData vert_out;\n\tvert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = v_in.uv;\n\treturn vert_out;\n}\n\nVertData main(VertData v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  result ok
backend pixelshader_create location="libobs/data/deinterlace_blend.effect (Pixel shader, technique Draw, pass 0)" len=674 fnv=5c03200d8e956f6e
  text "uniform int field_order;\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nuniform texture2d image;\n\n\nint3 select(int2 texel, int x, int y)\n{\n\treturn int3(texel + int2(x, y), 0);\n}\n\n\nfloat4 load_at_image(int2 texel, int x, int y)\n{\n\treturn image.Load(select(texel, x, y));\n}\n\n\nfloat4 texel_at_blend(int2 texel, int field)\n{\n\treturn (load_at_image(texel, 0, 0) + load_at_image(texel, 0, 1)) / 2;\n}\n\n\nuniform float2 dimensions;\n\n\nint2 pixel_uv(float2 uv)\n{\n\treturn int2(uv * dimensions);\n}\n\n\nfloat4 PSBlendRGBA(VertData v_in)\n{\n\treturn texel_at_blend(pixel_uv(v_in.uv), field_order);\n}\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSBlendRGBA(v_in);\n}\n"
  sparam 0 name=field_order type=INT array=0
  sparam 1 name=image type=TEXTURE array=0
  sparam 2 name=dimensions type=VEC2 array=0
  result ok
backend vertexshader_create location="libobs/data/deinterlace_blend.effect (Vertex shader, technique DrawMultiply, pass 0)" len=317 fnv=b06d11de3e765c86
  text "uniform float4x4 ViewProj;\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nVertData VSDefault(VertData v_in)\n{\n\tVertData vert_out;\n\tvert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);\n\tvert_out.uv  = v_in.uv;\n\treturn vert_out;\n}\n\nVertData main(VertData v_in)\n{\n\treturn VSDefault(v_in);\n}\n"
  sparam 0 name=ViewProj type=MATRIX4X4 array=0
  result ok
backend pixelshader_create location="libobs/data/deinterlace_blend.effect (Pixel shader, technique DrawMultiply, pass 0)" len=835 fnv=54fede4f67d72205
  text "uniform float multiplier;\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nuniform int field_order;\n\n\nuniform texture2d image;\n\n\nint3 select(int2 texel, int x, int y)\n{\n\treturn int3(texel + int2(x, y), 0);\n}\n\n\nfloat4 load_at_image(int2 texel, int x, int y)\n{\n\treturn image.Load(select(texel, x, y));\n}\n\n\nfloat4 texel_at_blend(int2 texel, int field)\n{\n\treturn (load_at_image(texel, 0, 0) + load_at_image(texel, 0, 1)) / 2;\n}\n\n\nuniform float2 dimensions;\n\n\nint2 pixel_uv(float2 uv)\n{\n\treturn int2(uv * dimensions);\n}\n\n\nfloat4 PSBlendRGBA(VertData v_in)\n{\n\treturn texel_at_blend(pixel_uv(v_in.uv), field_order);\n}\n\n\nfloat4 PSBlendRGBA_multiply(VertData v_in)\n{ \tfloat4 rgba =  PSBlendRGBA (v_in); \trgba.rgb *= multiplier; \treturn rgba; }\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSBlendRGBA_multiply(v_in);\n}\n"
  sparam 0 name=multiplier type=FLOAT array=0
  sparam 1 name=field_order type=INT array=0
  sparam 2 name=image type=TEXTURE array=0
