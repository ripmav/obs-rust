--- #if defined(...) is not supported by the C-like preprocessor (S-011);
effect a4 result=fail
  error_string="pp4.effect (1, 5): Expected identifier or number\npp4.effect (3, 2): #endif outside of #if/#ifdef/#ifndef block\n"
--- a user definition of the same name (see also 90-defects for using the name as an identifier)
effect a6 result=ok
  error_string=@null
effect a6 params=1 techniques=0 viewproj=- world=-
  param 0 name=redefined type=FLOAT annotations=0 default_size=0 default=-
