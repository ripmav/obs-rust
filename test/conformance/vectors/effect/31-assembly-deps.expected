--- dependency chain c <- b <- a: written c, b, a
backend vertexshader_create location="chain.effect (Vertex shader, technique T, pass 0)" len=117 fnv=b0b08d08adf2538a
  text "float c()\n{ return 1; }\n\n\nfloat b()\n{ return c(); }\n\n\nfloat a()\n{ return b() + c(); }\n\nfloat main()\n{\n\treturn a();\n}\n"
  result ok
backend pixelshader_create location="chain.effect (Pixel shader, technique T, pass 0)" len=117 fnv=b0b08d08adf2538a
