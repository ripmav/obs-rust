backend pixelshader_create location="plugins/obs-transitions/data/luma_wipe_transition.effect (Pixel shader, technique LumaWipe, pass 0)" len=907 fnv=1757e67147c18465
  text "uniform texture2d a_tex;\nuniform texture2d b_tex;\nuniform texture2d l_tex;\nuniform bool invert;\nuniform float softness;\nuniform float progress;\n\n\nsampler_state textureSampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\n\n\nstruct VertData {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nfloat4 PSLumaWipe(VertData v_in)\n{\n\tfloat2 uv = v_in.uv;\n\tfloat4 a_color = a_tex.Sample(textureSampler, uv);\n\tfloat4 b_color = b_tex.Sample(textureSampler, uv);\n\tfloat luma     = l_tex.Sample(textureSampler, uv).x;\n\n\tif (invert)\n\t\tluma = 1.0f - luma;\n\n\tfloat time = lerp(0.0f, 1.0f + softness, progress);\n\n\tfloat4 rgba;\n\tif (luma <= time - softness) {\n\t\trgba = b_color;\n\t} else if (luma >= time) {\n\t\trgba = a_color;\n\t} else {\n\t\tfloat alpha = (time - luma) / softness;\n\t\trgba = lerp(a_color, b_color, alpha);\n\t}\n\n\treturn rgba;\n}\n\nfloat4 main(VertData v_in) : TARGET\n{\n\treturn PSLumaWipe(v_in);\n}\n"
  sparam 0 name=a_tex type=TEXTURE array=0
  sparam 1 name=b_tex type=TEXTURE array=0
  sparam 2 name=l_tex type=TEXTURE array=0
  sparam 3 name=invert type=BOOL array=0
  sparam 4 name=softness type=FLOAT array=0
  sparam 5 name=progress type=FLOAT array=0
  result ok
