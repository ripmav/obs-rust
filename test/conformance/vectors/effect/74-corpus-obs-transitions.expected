backend pixelshader_create location="plugins/obs-transitions/data/fade_transition.effect (Pixel shader, technique FadeSingle, pass 0)" len=487 fnv=a315cb0c167789d3
  text "struct FragData {\n\tfloat2 uv : TEXCOORD0;\n};\n\nuniform texture2d tex_a;\nuniform float fade_val;\n\n\nsampler_state textureSampler {\n\tFilter = Linear;\n\n\tAddressU = Clamp;\n\n\tAddressV = Clamp;\n\n};\n\nfloat4 FadeSingle(FragData f_in)\n{\n\tfloat4 a_val = tex_a.Sample(textureSampler, f_in.uv);\n\tfloat4 rgba = a_val * fade_val;\n\treturn rgba;\n}\n\n\nfloat4 PSFadeSingle(FragData f_in)\n{\n\tfloat4 rgba = FadeSingle(f_in);\n\treturn rgba;\n}\n\nfloat4 main(FragData f_in) : TARGET\n{\n\treturn PSFadeSingle(f_in);\n}\n"
  sparam 0 name=tex_a type=TEXTURE array=0
