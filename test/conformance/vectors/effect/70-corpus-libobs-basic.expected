  text "uniform texture2d image;\n\n\nsampler_state def_sampler {\n\tFilter = Linear;\n\n\tAddressU = Repeat;\n\n\tAddressV = Repeat;\n\n};\n\nstruct VertInOut {\n\tfloat4 pos : POSITION;\n\tfloat2 uv : TEXCOORD0;\n};\n\nfloat4 PSDrawBare(VertInOut vert_in)\n{\n\treturn image.Sample(def_sampler, vert_in.uv);\n}\n\nfloat4 main(VertInOut vert_in) : TARGET\n{\n\treturn PSDrawBare(vert_in);\n}\n"
