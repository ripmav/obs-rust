echo defaults
fdk.aacEncOpen modules=0 channels=2
fdk.SetParam AOT=2
fdk.SetParam SAMPLERATE=48000
fdk.SetParam CHANNELMODE=2
fdk.SetParam CHANNELORDER=1
fdk.SetParam BITRATEMODE=0
fdk.SetParam BITRATE=128000
fdk.SetParam TRANSMUX=0
fdk.SetParam AFTERBURNER=1
fdk.aacEncEncode (init)
fdk.aacEncInfo
log info libfdk_aac encoder created
log info libfdk_aac bitrate: 128, channels: 2
fdk_state channels=2 sample_rate=48000 frame_size_bytes=4096 packet_buffer_size=8192
fdk.aacEncClose
log info libfdk_aac encoder destroyed
fdk_create ok
echo custom
fdk.aacEncOpen modules=0 channels=2
fdk.SetParam AOT=2
fdk.SetParam SAMPLERATE=48000
fdk.SetParam CHANNELMODE=2
fdk.SetParam CHANNELORDER=1
fdk.SetParam BITRATEMODE=0
fdk.SetParam BITRATE=192000
fdk.SetParam TRANSMUX=2
fdk.SetParam AFTERBURNER=0
fdk.aacEncEncode (init)
fdk.aacEncInfo
