fdk_state channels=2 sample_rate=48000 frame_size_bytes=4096 packet_buffer_size=8192
fdk.aacEncClose
log info libfdk_aac encoder destroyed
fdk_create ok
echo zero-bitrate
log error Invalid bitrate
fdk_create fail
echo negative-bitrate-passes-through-unchecked
