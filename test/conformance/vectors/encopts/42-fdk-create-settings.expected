log warning libfdk_aac encoder creation failed
fdk_create fail
echo setparam-fails-mid-way-closes-handle
fdk.aacEncOpen modules=0 channels=2
fdk.SetParam AOT=2
fdk.SetParam SAMPLERATE=48000
fdk.SetParam CHANNELMODE=2
fdk.SetParam -> INIT_ERROR
log error aacEncoder_SetParam(enc->fdkhandle, AACENC_CHANNELMODE, mode) failed: Initialization error
fdk.aacEncClose
log warning libfdk_aac encoder creation failed
fdk_create fail
