ax_frames untouched
echo video-ex-empty-produces-a-tag
ex_start size=20 hex=0900000500000000000000906176633100000010
  tag type=9 datasize=5 ts=0 streamid=0
    video ex=1 frametype=1 ptype=0 fourcc="avc1" payload=-
  prevsize=16 expected=16
ex_frames size=20 hex=0900000500000000000000936176633100000010
  tag type=9 datasize=5 ts=0 streamid=0
    video ex=1 frametype=1 ptype=3 fourcc="avc1" payload=-
  prevsize=16 expected=16
