echo one-byte payloads (the minimum that produces a tag everywhere)
flv_mux size=21 hex=0900000600000a0000000017010000000000000011
  tag type=9 datasize=6 ts=10 streamid=0
    video ex=0 frametype=1 codec=7 avcptype=1 cts=0 payload=00
  prevsize=17 expected=17
flv_mux size=18 hex=0800000300000a00000000af01000000000e
  tag type=8 datasize=3 ts=10 streamid=0
    audio ex=0 format=10 rate=3 size=1 type=1 aacptype=1 payload=00
  prevsize=14 expected=14
