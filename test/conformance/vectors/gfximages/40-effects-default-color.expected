effect libobs/data/default.effect parse=ok params=3 techniques=14 viewproj=ViewProj world=-
  param 0 ViewProj MATRIX4X4 default=-
  param 1 image TEXTURE default=-
  param 2 multiplier FLOAT default=-
  technique Draw passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawBare(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawAlphaDivide passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawAlphaDivide(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawAlphaDivideTonemap passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawAlphaDivideTonemap(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawAlphaDivideR10L passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawAlphaDivideR10L(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawNonlinearAlpha passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawNonlinearAlpha(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawNonlinearAlphaMultiply passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawNonlinearAlphaMultiply(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawSrgbDecompress passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawSrgbDecompress(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawSrgbDecompressMultiply passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawSrgbDecompressMultiply(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawMultiply passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawMultiply(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawTonemap passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawTonemap(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  technique DrawMultiplyTonemap passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawMultiplyTonemap(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawPQ passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawPQ(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawTonemapPQ passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawTonemapPQ(vert_in);
      vs_params=[ViewProj] ps_params=[image,multiplier]
  technique DrawD65P3 passes=1
    pass 0 name=@null vertex=VSDefault(vert_in); pixel=PSDrawD65P3(vert_in);
      vs_params=[ViewProj] ps_params=[image]
  funcs=36 structs=1 samplers=1
  sampler def_sampler Filter=Linear AddressU=Clamp AddressV=Clamp
