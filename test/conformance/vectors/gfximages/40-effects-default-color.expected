effect libobs/data/solid.effect parse=ok params=5 techniques=3 viewproj=ViewProj world=-
  param 0 ViewProj MATRIX4X4 default=-
  param 1 color VEC4 default=[1,1,1,1]
  param 2 randomvals1 VEC4 default=-
  param 3 randomvals2 VEC4 default=-
  param 4 randomvals3 VEC4 default=-
  technique Solid passes=1
    pass 0 name=@null vertex=VSSolid(vert_in); pixel=PSSolid(vert_in);
      vs_params=[ViewProj] ps_params=[color]
  technique SolidColored passes=1
    pass 0 name=@null vertex=VSSolidColored(vert_in); pixel=PSSolidColored(vert_in);
      vs_params=[ViewProj,color] ps_params=[color]
  technique Random passes=1
    pass 0 name=@null vertex=VSSolid(vert_in); pixel=PSRandom(vert_in);
      vs_params=[ViewProj] ps_params=[randomvals1,randomvals2,randomvals3]
  funcs=6 structs=2 samplers=0
