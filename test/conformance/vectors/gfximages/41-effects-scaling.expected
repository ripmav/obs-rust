    pass 0 name=@null vertex=VSDefault(v_in); pixel=PSDrawBicubicRGBAMultiplyTonemap(f_in,false);
      vs_params=[base_dimension,ViewProj] ps_params=[multiplier,base_dimension_i,base_dimension,image,undistort_factor]
  technique DrawUndistort passes=1
    pass 0 name=@null vertex=VSDefault(v_in); pixel=PSDrawBicubicRGBA(f_in,true);
      vs_params=[base_dimension,ViewProj] ps_params=[base_dimension_i,base_dimension,image,undistort_factor]
  technique DrawUndistortMultiply passes=1
    pass 0 name=@null vertex=VSDefault(v_in); pixel=PSDrawBicubicRGBAMultiply(f_in,true);
      vs_params=[base_dimension,ViewProj] ps_params=[multiplier,base_dimension_i,base_dimension,image,undistort_factor]
  technique DrawUndistortTonemap passes=1
    pass 0 name=@null vertex=VSDefault(v_in); pixel=PSDrawBicubicRGBATonemap(f_in,true);
      vs_params=[base_dimension,ViewProj] ps_params=[base_dimension_i,base_dimension,image,undistort_factor]
  technique DrawUndistortMultiplyTonemap passes=1
    pass 0 name=@null vertex=VSDefault(v_in); pixel=PSDrawBicubicRGBAMultiplyTonemap(f_in,true);
      vs_params=[base_dimension,ViewProj] ps_params=[multiplier,base_dimension_i,base_dimension,image,undistort_factor]
  funcs=33 structs=3 samplers=1
