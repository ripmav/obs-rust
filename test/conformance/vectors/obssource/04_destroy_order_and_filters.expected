echo after-release
  destroying f2
  cb F2 destroy
log debug private source 'F2' destroyed
  destroying f1
  cb F1 destroy
log debug private source 'F1' destroyed
  destroying a
  gsig source_destroy source=A
  sig destroy source=A
  cb A destroy
log debug source 'A' destroyed
drain ran=3
