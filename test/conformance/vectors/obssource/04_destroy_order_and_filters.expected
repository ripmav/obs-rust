  cb A create
log debug source 'A' (in) created
create a ok
  cb F1 create
log debug private source 'F1' (fl) created
create f1 ok
  cb F2 create
log debug private source 'F2' (fl) created
create f2 ok
log debug - filter 'F1' (fl) added to source 'A'
  cb F1 filter_add parent=A
log debug - filter 'F2' (fl) added to source 'A'
  cb F2 filter_add parent=A
  gsig source_filter_remove source=A filter=F2
  sig filter_remove source=A filter=F2
