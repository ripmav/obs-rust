> pulse-server pulseaudio 16.1 alsa_input.mic alsa_output.speakers
> pulse-source alsa_input.mic Mic - s16le 48000 2
> pulse-source alsa_input.s24 S24 - s24le 44100 6
> pulse-source alsa_input.ch7 Seven - s32le 96000 7
> pulse-source alsa_input.mono Mono - float32le 8000 1
> pulse-source alsa_output.speakers.monitor Mon 0 float32le 48000 8
> pulse-defaults
> source-name Mic1
> set-str device_id default
> pulse-create input
