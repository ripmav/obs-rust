> pulse-fmt u8
pulse-fmt u8 -> U8BIT
> pulse-fmt s16le
pulse-fmt s16le -> 16BIT
> pulse-fmt s32le
pulse-fmt s32le -> 32BIT
> pulse-fmt float32le
pulse-fmt float32le -> FLOAT
> pulse-fmt s24le
pulse-fmt s24le -> UNKNOWN
> pulse-fmt s24-32le
pulse-fmt s24-32le -> UNKNOWN
> pulse-fmt alaw
pulse-fmt alaw -> UNKNOWN
> pulse-fmt ulaw
pulse-fmt ulaw -> UNKNOWN
> pulse-fmt s16be
pulse-fmt s16be -> UNKNOWN
> pulse-fmt float32be
pulse-fmt float32be -> UNKNOWN
> pulse-fmt-num -1
pulse-fmt-num -1 -> UNKNOWN
> pulse-ch 0
pulse-ch 0 -> UNKNOWN
> pulse-ch 1
pulse-ch 1 -> MONO
> pulse-ch 2
pulse-ch 2 -> STEREO
> pulse-ch 3
pulse-ch 3 -> 2.1
> pulse-ch 4
pulse-ch 4 -> 4.0
> pulse-ch 5
pulse-ch 5 -> 4.1
> pulse-ch 6
pulse-ch 6 -> 5.1
> pulse-ch 7
pulse-ch 7 -> UNKNOWN
> pulse-ch 8
pulse-ch 8 -> 7.1
> pulse-ch 9
pulse-ch 9 -> UNKNOWN
> pulse-chmap 0
pulse-chmap UNKNOWN channels=0: - - - - - - - -
> pulse-chmap 1
pulse-chmap MONO channels=1: mono - - - - - - -
> pulse-chmap 2
pulse-chmap STEREO channels=2: front-left front-right - - - - - -
> pulse-chmap 3
pulse-chmap 2.1 channels=3: front-left front-right lfe - - - - -
> pulse-chmap 4
pulse-chmap 4.0 channels=4: front-left front-right front-center rear-center - - - -
> pulse-chmap 5
pulse-chmap 4.1 channels=5: front-left front-right front-center lfe rear-center - - -
> pulse-chmap 6
pulse-chmap 5.1 channels=6: front-left front-right front-center lfe rear-left rear-right - -
> pulse-chmap 7
pulse-chmap OTHER channels=0: - - - - - - - -
> pulse-chmap 8
pulse-chmap 7.1 channels=8: front-left front-right front-center lfe rear-left rear-right side-left side-right
> pulse-chmap 99
pulse-chmap OTHER channels=0: - - - - - - - -
> pulse-timecalc 480 48000
samples_to_ns 10000000
> pulse-timecalc 1 48000
samples_to_ns 20833
> pulse-timecalc 1 44100
samples_to_ns 22675
> pulse-timecalc 0 48000
samples_to_ns 0
> pulse-timecalc 4096 44100
samples_to_ns 92879818
> pulse-timecalc 10000000000 48000
samples_to_ns 208333333333333
