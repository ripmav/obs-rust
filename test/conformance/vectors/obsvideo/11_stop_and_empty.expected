ev gs_set_cull_mode 2
ev gs_ortho 0 64 0 36 -100 100
ev gs_set_viewport 0 0 64 36
ev obs_view_render A.view
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs B.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 64 0 36 -100 100
ev gs_set_viewport 0 0 64 36
ev obs_view_render B.view
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
