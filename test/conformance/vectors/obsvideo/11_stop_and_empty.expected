--- no mixes: one frame is still executed, then the loop reports stop
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev tick_callback T seconds=9.99999997e-07
ev sp_render_begin
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 6000 -> 1
loop -> 0 last_time=5000 frame_time_total=0 fps_total_ns=1000 fps_frames=1
--- two mixes, A keeps running (stop_after 5), B already stopped (stop_after 0)
loop -> 1 last_time=6000 frame_time_total=0 fps_total_ns=2000 fps_frames=2
loop -> 1 last_time=7000 frame_time_total=0 fps_total_ns=3000 fps_frames=3
loop -> 1 last_time=8000 frame_time_total=0 fps_total_ns=4000 fps_frames=4
--- all stopped again
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev tick_callback T seconds=9.99999997e-07
ev sp_render_begin
ev gs_enter_context
