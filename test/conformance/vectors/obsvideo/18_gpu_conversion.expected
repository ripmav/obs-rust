--- I420: three planes
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs Y.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render Y.view
ev gs_enable_blending 0
ev effect_set_texture conversion.image = Y.render
ev effect_set_vec4 color_vec0 = 4.5,5.5,6.5,7.5
ev effect_set_float sdr_white_nits_over_maximum = 0.0299999993
ev effect_set_float hdr_lw = 1000
ev gs_set_render_target Y.conv0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev technique_begin conversion.Tech0 passes=1
ev technique_pass 0
ev gs_draw mode=3 start=0 n=3
ev technique_end
ev effect_set_texture conversion.image = Y.render
ev effect_set_vec4 color_vec1 = 0.5,1.5,2.5,3.5
ev effect_set_float width_i = 0.0625
ev effect_set_float height_i = 0.0625
ev effect_set_float sdr_white_nits_over_maximum = 0.0299999993
ev effect_set_float hdr_lw = 1000
ev gs_set_render_target Y.conv1
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 8 0 8 -100 100
ev gs_set_viewport 0 0 8 8
ev technique_begin conversion.Tech1 passes=1
ev technique_pass 0
ev gs_draw mode=3 start=0 n=3
ev technique_end
ev effect_set_texture conversion.image = Y.render
ev effect_set_vec4 color_vec2 = 8.5,9.5,10.5,11.5
ev effect_set_float width_i = 0.0625
ev effect_set_float height_i = 0.0625
ev effect_set_float sdr_white_nits_over_maximum = 0.0299999993
ev effect_set_float hdr_lw = 1000
ev gs_set_render_target Y.conv2
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 8 0 8 -100 100
ev gs_set_viewport 0 0 8 8
ev technique_begin conversion.Tech2 passes=1
ev technique_pass 0
ev gs_draw mode=3 start=0 n=3
ev technique_end
ev gs_enable_blending 1
ev gs_stage_texture Y.surf0_0 <- Y.conv0
ev gs_stage_texture Y.surf0_1 <- Y.conv1
ev gs_stage_texture Y.surf0_2 <- Y.conv2
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 2000 -> 1
loop -> 1 last_time=1000 frame_time_total=0 fps_total_ns=1000 fps_frames=1
mix Y raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=1 rendered=1 converted=1 copied=1,0 vframes=1 vframes_gpu=0 gpu_q=0 gpu_avail=0
mix Y active_surfaces: [0][0]=Y.surf0_0 [0][1]=Y.surf0_1 [0][2]=Y.surf0_2 [1][0]=null [1][1]=null [1][2]=null
mix Y mapped: 0 0 0
--- NV12 (two planes: UV plane gets color_vec1 AND color_vec2)
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs Y.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render Y.view
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs N.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render N.view
ev gs_enable_blending 0
ev effect_set_texture conversion.image = N.render
ev effect_set_vec4 color_vec0 = 4.5,5.5,6.5,7.5
ev effect_set_float sdr_white_nits_over_maximum = 0.0299999993
ev effect_set_float hdr_lw = 1000
ev gs_set_render_target N.conv0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev technique_begin conversion.Tech0 passes=1
ev technique_pass 0
ev gs_draw mode=3 start=0 n=3
ev technique_end
ev effect_set_texture conversion.image = N.render
ev effect_set_vec4 color_vec1 = 0.5,1.5,2.5,3.5
ev effect_set_vec4 color_vec2 = 8.5,9.5,10.5,11.5
ev effect_set_float width_i = 0.0625
ev effect_set_float height_i = 0.0625
ev effect_set_float sdr_white_nits_over_maximum = 0.0299999993
ev effect_set_float hdr_lw = 1000
ev gs_set_render_target N.conv1
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 8 -100 100
ev gs_set_viewport 0 0 16 8
ev technique_begin conversion.Tech1 passes=1
ev technique_pass 0
ev gs_draw mode=3 start=0 n=3
ev technique_end
ev gs_enable_blending 1
ev gs_stage_texture N.surf0_0 <- N.conv0
ev gs_stage_texture N.surf0_1 <- N.conv1
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 3000 -> 1
loop -> 1 last_time=2000 frame_time_total=0 fps_total_ns=2000 fps_frames=2
mix N raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=1 rendered=1 converted=1 copied=1,0 vframes=1 vframes_gpu=0 gpu_q=0 gpu_avail=0
mix N active_surfaces: [0][0]=N.surf0_0 [0][1]=N.surf0_1 [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix N mapped: 0 0 0
