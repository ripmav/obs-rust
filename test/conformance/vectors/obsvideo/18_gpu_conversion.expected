ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs Y.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render Y.view
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs N.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render N.view
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs T.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 16 0 16 -100 100
ev gs_set_viewport 0 0 16 16
ev obs_view_render T.view
ev gs_enable_blending 0
ev gs_enable_blending 1
ev gs_stagesurface_unmap T.surf0_0
ev gs_stagesurface_unmap T.surf0_1
ev gs_stagesurface_unmap T.surf0_2
ev gs_stage_texture T.surf0_0 <- null
ev gs_stage_texture T.surf0_2 <- T.conv2
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_stagesurface_map T.surf1_0 linesize=16
ev gs_stagesurface_map T.surf1_1 linesize=16
ev gs_stagesurface_map T.surf1_2 linesize=16
ev gs_flush
ev gs_leave_context
ev video_output_lock_frame T count=1 ts=4000 -> 1
ev video_output_unlock_frame T
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 6000 -> 1
loop -> 1 last_time=5000 frame_time_total=0 fps_total_ns=5000 fps_frames=5
mix T raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=1 rendered=1 converted=1 copied=1,1 vframes=1 vframes_gpu=0 gpu_q=0 gpu_avail=0
mix T active_surfaces: [0][0]=T.surf0_0 [0][1]=null [0][2]=T.surf0_2 [1][0]=T.surf1_0 [1][1]=T.surf1_1 [1][2]=T.surf1_2
mix T mapped: 1 1 1
