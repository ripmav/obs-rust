ev sleepto 3000 -> 1
loop -> 1 last_time=2000 frame_time_total=0 fps_total_ns=2000 fps_frames=2
sem_posts=1
avail_count=9
queue[0] tex=M.encY uv=M.encUV count=1 ts=1000 key=0 released=1
texture_frames=0 skipped=0
--- an entry with count 3 while the queue is non-empty: the first two units duplicate the newest queued frame (its count grows by 2), the last unit has count 1 and so queues a NEW frame (3 posts)
loop -> 1 last_time=3000 frame_time_total=0 fps_total_ns=3000 fps_frames=3
sem_posts=4
avail_count=8
queue[0] tex=M.encY uv=M.encUV count=3 ts=1000 key=0 released=1
queue[1] tex=enc0.y uv=enc0.uv count=1 ts=77 key=0 released=1
texture_frames=0 skipped=0
--- empty queue + count 2: not a duplicate (queue empty) -> copy path creates a frame, then count 1 creates a second frame
