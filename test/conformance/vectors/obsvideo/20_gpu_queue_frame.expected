ev sleepto 7000 -> 1
loop -> 1 last_time=6000 frame_time_total=0 fps_total_ns=6000 fps_frames=6
avail_count=5
queue[0] tex=enc4.y uv=enc4.uv count=1 ts=99 key=0 released=1
texture_frames=0 skipped=0
--- avail queue exhausted: duplicates the newest queued frame
loop -> 1 last_time=7000 frame_time_total=0 fps_total_ns=7000 fps_frames=7
avail_count=0
queue[0] tex=enc4.y uv=enc4.uv count=2 ts=99 key=0 released=1
texture_frames=0 skipped=0
--- avail exhausted and encode queue empty: nothing to duplicate, the entry is consumed, nothing is posted
loop -> 1 last_time=8000 frame_time_total=0 fps_total_ns=8000 fps_frames=8
avail_count=0
texture_frames=0 skipped=0
mix M raw_active=0 gpu_active=1 raw_was=0 gpu_was=1 was=1 cur_texture=0 rendered=1 converted=1 copied=1,1 vframes=1 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=M.surf0_1 [0][2]=null [1][0]=M.surf1_0 [1][1]=M.surf1_1 [1][2]=null
mix M mapped: 1 1 0
--- a GPU-active mix WITHOUT gpu conversion never sets texture_converted: its vframe entries are never consumed (they accumulate, one per frame)
loop -> 1 last_time=9000 frame_time_total=0 fps_total_ns=9000 fps_frames=9
loop -> 1 last_time=10000 frame_time_total=0 fps_total_ns=10000 fps_frames=10
loop -> 1 last_time=11000 frame_time_total=0 fps_total_ns=11000 fps_frames=11
loop -> 1 last_time=12000 frame_time_total=0 fps_total_ns=12000 fps_frames=12
mix B raw_active=0 gpu_active=1 raw_was=0 gpu_was=1 was=1 cur_texture=0 rendered=1 converted=0 copied=0,0 vframes=0 vframes_gpu=4 gpu_q=0 gpu_avail=0
mix B active_surfaces: [0][0]=null [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix B mapped: 0 0 0
