loop -> 1 last_time=1200 frame_time_total=0 fps_total_ns=400 fps_frames=3
counters total_frames=4 lagged_frames=1 video_time=1400 fps=0 avg_frame_time_ns=0 mixes=1 ctx_depth=0 underflow=0
