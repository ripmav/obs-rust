loop -> 1 last_time=1100 frame_time_total=0 fps_total_ns=200 fps_frames=2
counters total_frames=2 lagged_frames=0 video_time=1200 fps=0 avg_frame_time_ns=0 mixes=1 ctx_depth=0 underflow=0
