--- multi-pass technique runs each pass
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs S.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 1920 0 1080 -100 100
ev gs_set_viewport 0 0 1920 1080
ev obs_view_render S.view
ev gs_set_render_target S.output
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 1280 0 720 -100 100
ev gs_set_viewport 0 0 1280 720
ev effect_set_texture_srgb default.image = S.render
ev gs_enable_framebuffer_srgb 1
ev gs_enable_blending 0
ev technique_begin default.Draw passes=3
ev technique_pass 0
ev gs_draw_sprite S.render flip=0 1280x720
ev technique_pass 1
ev gs_draw_sprite S.render flip=0 1280x720
ev technique_pass 2
ev gs_draw_sprite S.render flip=0 1280x720
ev technique_end
ev gs_enable_blending 1
ev gs_enable_framebuffer_srgb 0
ev gs_stagesurface_unmap S.surf1_0
ev gs_stage_texture S.surf1_0 <- S.output
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_stagesurface_map S.surf0_0 linesize=7680
ev gs_flush
ev gs_leave_context
ev video_output_lock_frame S count=1 ts=15000 -> 1
ev video_output_unlock_frame S
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 17000 -> 1
loop -> 1 last_time=16000 frame_time_total=0 fps_total_ns=16000 fps_frames=16
