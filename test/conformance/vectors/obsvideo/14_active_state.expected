--- idle mix: nothing latched, stale data untouched (but cur_texture advanced by the frame)
loop -> 1 last_time=100000 frame_time_total=0 fps_total_ns=1000 fps_frames=1
mix M raw_active=0 gpu_active=0 raw_was=0 gpu_was=0 was=0 cur_texture=0 rendered=1 converted=0 copied=0,0 vframes=1 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=null [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- raw consumer appears
loop -> 1 last_time=101000 frame_time_total=0 fps_total_ns=2000 fps_frames=2
mix M raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=1 rendered=1 converted=0 copied=1,0 vframes=1 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- push a raw vframe then drop the consumer: data kept
loop -> 1 last_time=102000 frame_time_total=0 fps_total_ns=3000 fps_frames=3
mix M raw_active=0 gpu_active=0 raw_was=0 gpu_was=0 was=0 cur_texture=0 rendered=1 converted=0 copied=1,0 vframes=2 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- gpu consumer appears while the raw buffer still holds data: base reset also frees raw info
loop -> 1 last_time=103000 frame_time_total=0 fps_total_ns=4000 fps_frames=4
mix M raw_active=0 gpu_active=1 raw_was=0 gpu_was=1 was=1 cur_texture=1 rendered=1 converted=0 copied=1,0 vframes=0 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- both active at once (raw rising while gpu already active -> only raw reset; was_active stays true)
loop -> 1 last_time=104000 frame_time_total=0 fps_total_ns=5000 fps_frames=5
mix M raw_active=1 gpu_active=1 raw_was=1 gpu_was=1 was=1 cur_texture=0 rendered=1 converted=0 copied=0,1 vframes=1 vframes_gpu=3 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=M.surf1_0 [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- counters above 1 count as active
loop -> 1 last_time=105000 frame_time_total=0 fps_total_ns=6000 fps_frames=6
loop -> 1 last_time=106000 frame_time_total=0 fps_total_ns=7000 fps_frames=7
mix M raw_active=3 gpu_active=2 raw_was=1 gpu_was=1 was=1 cur_texture=1 rendered=1 converted=0 copied=1,0 vframes=1 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=M.surf1_0 [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- negative counter does not count as active
loop -> 1 last_time=107000 frame_time_total=0 fps_total_ns=8000 fps_frames=8
mix M raw_active=-1 gpu_active=-1 raw_was=0 gpu_was=0 was=0 cur_texture=0 rendered=1 converted=0 copied=1,0 vframes=1 vframes_gpu=1 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=M.surf1_0 [1][1]=null [1][2]=null
mix M mapped: 0 0 0
