--- two mixes share the view: B reuses A's texture (A is rendered first within the same frame)
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs A.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 640 0 360 -100 100
ev gs_set_viewport 0 0 640 360
ev draw_callback D3 640x360
ev draw_callback D2 640x360
ev draw_callback D1 640x360
ev obs_view_render A.view
ev rendered_callback R1
ev rendered_callback R2
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs B.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 640 0 360 -100 100
ev gs_set_viewport 0 0 640 360
ev draw_callback D3 640x360
ev draw_callback D2 640x360
ev draw_callback D1 640x360
ev effect_set_texture_srgb default.image = A.render
ev gs_enable_framebuffer_srgb 1
ev effect_loop default Draw begin
ev gs_draw_sprite A.render flip=0 0x0
ev gs_enable_framebuffer_srgb 0
ev rendered_callback R1
ev rendered_callback R2
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 2000 -> 1
loop -> 1 last_time=1000 frame_time_total=0 fps_total_ns=1000 fps_frames=1
