--- C has its own view object: it renders the view itself (A and B are not candidates for C because the view differs)
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs A.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
