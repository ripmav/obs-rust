--- frame 1: renders+stages into slot 0, nothing to download (prev slot never copied)
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs M.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 4 0 2 -100 100
ev gs_set_viewport 0 0 4 2
ev obs_view_render M.view
ev gs_stage_texture M.surf0_0 <- M.render
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_flush
ev gs_leave_context
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 11000 -> 1
loop -> 1 last_time=10000 frame_time_total=0 fps_total_ns=1000 fps_frames=1
mix M raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=1 rendered=1 converted=0 copied=1,0 vframes=1 vframes_gpu=0 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=null [1][1]=null [1][2]=null
mix M mapped: 0 0 0
--- frame 2: stages slot 1, downloads slot 0, lock_frame, copies rows (line sizes equal: single memcpy)
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs M.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 4 0 2 -100 100
ev gs_set_viewport 0 0 4 2
ev obs_view_render M.view
ev gs_stage_texture M.surf1_0 <- M.render
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_stagesurface_map M.surf0_0 linesize=16
ev gs_flush
ev gs_leave_context
ev video_output_lock_frame M count=1 ts=10000 -> 1
ev video_output_unlock_frame M
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 12000 -> 1
loop -> 1 last_time=11000 frame_time_total=0 fps_total_ns=2000 fps_frames=2
mix M raw_active=1 gpu_active=0 raw_was=1 gpu_was=0 was=1 cur_texture=0 rendered=1 converted=0 copied=1,1 vframes=1 vframes_gpu=0 gpu_q=0 gpu_avail=0
mix M active_surfaces: [0][0]=M.surf0_0 [0][1]=null [0][2]=null [1][0]=M.surf1_0 [1][1]=null [1][2]=null
mix M mapped: 1 0 0
out M plane0 01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3da
--- frame 3: unmap previous, stage slot 0 again, download slot 1
ev sp_frame_begin
ev gs_enter_context
ev gs_begin_frame
ev gs_leave_context
ev sp_render_begin
ev gs_enter_context
ev gs_begin_scene
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_set_render_target_cs M.render cs=0
ev gs_clear flags=1 color=0,0,0,0 depth=1 stencil=0
ev gs_enable_depth_test 0
ev gs_set_cull_mode 2
ev gs_ortho 0 4 0 2 -100 100
ev gs_set_viewport 0 0 4 2
ev obs_view_render M.view
ev gs_stagesurface_unmap M.surf0_0
ev gs_stage_texture M.surf0_0 <- M.render
ev gs_set_render_target null
ev gs_enable_blending 1
ev gs_end_scene
ev gs_stagesurface_map M.surf1_0 linesize=16
ev gs_flush
ev gs_leave_context
ev video_output_lock_frame M count=1 ts=11000 -> 1
ev video_output_unlock_frame M
ev gs_enter_context
ev gs_leave_context
ev sp_render_end
ev sp_frame_collect
ev sleepto 13000 -> 1
loop -> 1 last_time=12000 frame_time_total=0 fps_total_ns=3000 fps_frames=3
out M plane0 01080f161d242b323940474e555c636a71787f868d949ba2a9b0b7bec5ccd3da
