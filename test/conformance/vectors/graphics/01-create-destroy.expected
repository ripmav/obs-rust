== destroy runs the backend teardown inside the context and releases the 4 vertex buffers
> gs_destroy g2
  dev device_enter_context
  dev gs_vertexbuffer_destroy vb=#14
  dev gs_vertexbuffer_destroy vb=#15
  dev gs_vertexbuffer_destroy vb=#13
  dev gs_vertexbuffer_destroy vb=#12
  dev device_destroy device=#11
  os_dlclose
> gs_destroy g1
  dev device_enter_context
  dev gs_vertexbuffer_destroy vb=#9
  dev gs_vertexbuffer_destroy vb=#10
  dev gs_vertexbuffer_destroy vb=#8
  dev gs_vertexbuffer_destroy vb=#7
  dev device_destroy device=#6
  os_dlclose
> gs_destroy g0
  dev device_enter_context
  dev gs_vertexbuffer_destroy vb=#4
  dev gs_vertexbuffer_destroy vb=#5
  dev gs_vertexbuffer_destroy vb=#3
  dev gs_vertexbuffer_destroy vb=#2
  dev device_destroy device=#1
  os_dlclose
