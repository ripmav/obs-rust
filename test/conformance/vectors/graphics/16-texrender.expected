  dev device_get_render_target
  dev device_get_zstencil_target
  dev device_get_color_space
  dev device_set_render_target_with_color_space tex=#7 zs=null space=0
  dev device_set_viewport x=0 y=0 w=32 h=16
ret true
> gs_texrender_end tr
  dev device_set_render_target_with_color_space tex=null zs=null space=0
  dev device_projection_pop
  dev device_set_viewport x=5 y=6 w=7 h=8
