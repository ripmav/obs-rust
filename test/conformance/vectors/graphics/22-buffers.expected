== without DUP the backend receives the caller's own arrays (ownership passes to the backend)
> gs_vertexbuffer_create 3 0 1 1 1 > vb
  dev device_vertexbuffer_create flags=0
    vb num=3 num_tex=1 points=(0,0,0) (1,2,3) (2,4,6) normals=(0,0,1) (0,0,1) (0,0,1) tangents=null colors=ff000000 ff000001 ff000002 tex0[w=2]=(0,0) (0.5,0) (1,0)
ret #6
> gs_vertexbuffer_get_data vb
  dev gs_vertexbuffer_get_data vb=#6
ret data num=3
== with DUP the backend receives a deep copy (points, normals, colors, texcoords, but no tangents)
> gs_vertexbuffer_create 2 GS_DUP_BUFFER 1 1 2 > vb2
  dev device_vertexbuffer_create flags=16
    vb num=2 num_tex=2 points=(0,0,0) (1,2,3) normals=(0,0,1) (0,0,1) tangents=null colors=ff000000 ff000001 tex0[w=2]=(0,0) (0.5,0) tex1[w=2]=(0,1) (0.5,1)
ret #7
== DUP with an empty buffer is NOT copied: the very same pointer is passed through
> gs_vertexbuffer_create 0 GS_DUP_BUFFER 0 0 0 > vb3
  dev device_vertexbuffer_create flags=16
    vb num=0 num_tex=0 points=- normals=null tangents=null colors=null
ret #8
