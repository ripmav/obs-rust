echo ---- the thread finds a media object that was opened meanwhile: it does nothing
mp.create path="srt://x:1" format="" options=""
    buffering=2097152 speed=100 force_range=0 linear_alpha=0 hw=0 local=0 reconnecting=1 preload=0 full_decode=0 cbs=11111
mp.play #4 looping=0 reconnecting=1
host.output_video null
host.media_started
thread.run
event.timedwait ms=7000 -> timeout
thread.done
echo ---- an update cancels the pending reconnect and re-opens
host.output_video null
host.media_ended
mp.destroy #4
event.signal
thread.join pending=0
event.reset
thread.create
event.signal
thread.join pending=1
event.timedwait ms=7000 -> signaled
event.reset
