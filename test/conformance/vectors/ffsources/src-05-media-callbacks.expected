state 6
source input="/m/a.mp4" input_format=@null ffmpeg_options=""
  buffering_mb=2 speed_percent=100 range=0 reconnect_delay_sec=0 state=6
  looping=0 local=1 hw=0 full_decode=0 clear_on_end=1 restart_on_activate=1 close_when_inactive=0
