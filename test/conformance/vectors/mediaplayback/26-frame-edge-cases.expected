ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff read #0 stream=0 pts=0 size=4
log error MP: media frame width or height are zero ('zero': 0x0)
mreset -> 1
tick -> idle
log error MP: media frame width or height are zero ('zero': 0x0)
ff read #1 stream=0 pts=40 size=4
tick -> played
sleep 40
log error MP: media frame width or height are zero ('zero': 0x0)
ff decoder drain
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff read #0 stream=0 pts=0 size=4
log error MP: media frame width or height are zero ('zero': 0x0)
cb stop
tick -> eof
tick -> idle
mfree
