tick -> idle
# ---- while active the request is consumed without delivery
tick -> idle
cb video ts=0 fmt=I420 8x4 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 mat0=1.16438 min0=0.0627451 max0=0.921569
ff read #1 stream=0 pts=40 size=4
tick -> played
sleep 40
cb video ts=40000000 fmt=I420 8x4 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 mat0=1.16438 min0=0.0627451 max0=0.921569
ff read #2 stream=0 pts=80 size=4
tick -> played
# ---- without a preload callback preload_frame() is a no-op
mfree
