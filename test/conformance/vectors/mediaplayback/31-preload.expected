# ---- request_preload=0: reset delivers the preload frame, preload_frame() is a no-op
minit -> ok
ff open path=pre format=- nobuffer=1 interrupt=0 opts=[]
minit2 -> ok has_v=1 has_a=0
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff read #0 stream=0 pts=0 size=4
cb preload ts=0 fmt=I420 8x4 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 mat0=1.16438 min0=0.0627451 max0=0.921569
mreset -> 1
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=1 has_a=0
  base_ts=0 start_ts=0 play_sys_ts=1000000000 next_pts_ns=0 next_ns=0 seek_pos=0 speed=100 cur_space=DEFAULT cur_range=DEFAULT
  v ready=1 pts=0 next_pts=40000000 last_dur=40000000 eof=0 key=0 pending=0 npkts=0
mfree
# ---- request_preload=1: reset delivers nothing; an explicit request does
