cb video ts=250000000 fmt=I420 16x16 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 ls0=16 d0=21 mat0=1.16438 min0=0.0627451 max0=0.921569
cb audio ts=250000000 fmt=16BIT spk=STEREO rate=96000 frames=4800 d0=32
ff decoder drain
ff decoder drain
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff decoder flush
ff read #0 stream=0 pts=0 size=4
ff read #1 stream=1 pts=0 size=4
cb preload ts=350000000 fmt=I420 16x16 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 ls0=16 d0=01 mat0=1.16438 min0=0.0627451 max0=0.921569
cb stop
tick -> eof
tick -> idle
mtime -> 100
