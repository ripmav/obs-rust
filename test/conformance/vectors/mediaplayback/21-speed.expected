# ---- QUIRK: duration estimate from the pts difference mixes the scaled previous pts with the unscaled new one
minit -> ok
ff open path=sp2 format=- nobuffer=1 interrupt=0 opts=[]
minit2 -> ok has_v=1 has_a=0
ff read #0 stream=0 pts=0 size=4
mnextpkt -> ok
mdecode v -> 1
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=1 has_a=0
  base_ts=0 start_ts=0 play_sys_ts=0 next_pts_ns=0 next_ns=0 seek_pos=0 speed=50 cur_space=DEFAULT cur_range=DEFAULT
  v ready=1 pts=0 next_pts=80000000 last_dur=80000000 eof=0 key=0 pending=0 npkts=0
ff read #1 stream=0 pts=100 size=4
mnextpkt -> ok
mdecode v -> 1
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=1 has_a=0
  base_ts=0 start_ts=0 play_sys_ts=0 next_pts_ns=0 next_ns=0 seek_pos=0 speed=50 cur_space=DEFAULT cur_range=DEFAULT
  v ready=1 pts=200000000 next_pts=360000000 last_dur=160000000 eof=0 key=0 pending=0 npkts=0
ff read #2 stream=0 pts=200 size=4
mnextpkt -> ok
mdecode v -> 1
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=1 has_a=0
  base_ts=0 start_ts=0 play_sys_ts=0 next_pts_ns=0 next_ns=0 seek_pos=0 speed=50 cur_space=DEFAULT cur_range=DEFAULT
  v ready=1 pts=400000000 next_pts=400000000 last_dur=0 eof=0 key=0 pending=0 npkts=0
ff read #3 stream=0 pts=300 size=4
mnextpkt -> ok
mdecode v -> 1
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=1 has_a=0
  base_ts=0 start_ts=0 play_sys_ts=0 next_pts_ns=0 next_ns=0 seek_pos=0 speed=50 cur_space=DEFAULT cur_range=DEFAULT
  v ready=1 pts=600000000 next_pts=400000000 last_dur=-200000000 eof=0 key=0 pending=0 npkts=0
