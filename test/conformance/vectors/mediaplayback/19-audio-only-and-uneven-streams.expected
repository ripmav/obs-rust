cb audio ts=120000000 fmt=U8BIT spk=MONO rate=1000 frames=40
tick -> played
sleep 40
cb audio ts=160000000 fmt=U8BIT spk=MONO rate=1000 frames=40
ff decoder drain
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff decoder flush
ff read #0 stream=0 pts=0 size=4
ff read #1 stream=1 pts=0 size=4
cb preload ts=280000000 fmt=I420 8x4 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 mat0=1.16438 min0=0.0627451 max0=0.921569
cb stop
tick -> eof
tick -> idle
tick -> idle
tick -> idle
mfree
# ---- seek on a network source
minit -> ok
ff open path=uneven format=- nobuffer=1 interrupt=1 opts=[stimeout=30000000]
minit2 -> ok has_v=1 has_a=1
ff read #0 stream=0 pts=0 size=4
ff read #1 stream=1 pts=0 size=4
mreset -> 1
tick -> idle
cb video ts=160000000 fmt=I420 8x4 flip=0 full=0 trc=DEFAULT maxlum=0 flags=0 mat0=1.16438 min0=0.0627451 max0=0.921569
cb audio ts=160000000 fmt=U8BIT spk=MONO rate=1000 frames=40
