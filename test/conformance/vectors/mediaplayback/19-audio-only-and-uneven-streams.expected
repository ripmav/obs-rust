# ---- audio only
minit -> ok
ff open path=ao format=- nobuffer=1 interrupt=0 opts=[]
minit2 -> ok has_v=0 has_a=1
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff read #0 stream=0 pts=0 size=4
mreset -> 1
tick -> idle
cb audio ts=0 fmt=16BIT_PLANAR spk=STEREO rate=1000 frames=40
ff read #1 stream=0 pts=40 size=4
tick -> played
sleep 40
cb audio ts=40000000 fmt=16BIT_PLANAR spk=STEREO rate=1000 frames=40
ff read #2 stream=0 pts=80 size=4
tick -> played
sleep 40
cb audio ts=80000000 fmt=16BIT_PLANAR spk=STEREO rate=1000 frames=20
ff decoder drain
ff seek stream=0 target=0 flags=BACKWARD
ff decoder flush
ff read #0 stream=0 pts=0 size=4
cb stop
tick -> eof
tick -> idle
tick -> idle
mstate eof=0 active=0 stopping=0 looping=0 pause=0 reset=0 seek=0 seek_next_ts=0 reset_ts=0 preload_frame=0 has_v=0 has_a=1
  base_ts=100000000 start_ts=0 play_sys_ts=1080000000 next_pts_ns=0 next_ns=0 seek_pos=0 speed=100 cur_space=DEFAULT cur_range=DEFAULT
  a ready=1 pts=0 next_pts=40000000 last_dur=40000000 eof=0 key=0 pending=0 npkts=0
mfree
