add frame_rate fr ok
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=0 ranges=0
fr_option_add -> 0
fr_option_add -> 1
fr_option_add -> 2
fr_range_add -> 0
fr_range_add -> 1
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=5 ranges=4
     option 0 name="First" desc="first desc"
     option 1 name="Auto" desc="Automatic"
     option 2 name="Pal" desc=@null
     option 3 name=@null desc="x"
     option 4 name="Last" desc="last desc"
     range 0 min=1/1 max=10/1
     range 1 min=30/1 max=60/1
     range 2 min=24000/1001 max=30000/1001
     range 3 min=0/0 max=5/0
echo clear-options-only
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=0 ranges=4
     range 0 min=1/1 max=10/1
     range 1 min=30/1 max=60/1
     range 2 min=24000/1001 max=30000/1001
     range 3 min=0/0 max=5/0
echo clear-ranges-only
fr_option_add -> 0
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=1 ranges=0
     option 0 name="Again" desc="again"
echo clear-all
fr_range_add -> 0
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=0 ranges=0
echo reuse-after-clear
fr_option_add -> 0
fr_range_add -> 0
info
  prop fr type=frame_rate desc="FPS" long=@null enabled=1 visible=1
    options=1 ranges=1
     option 0 name="n" desc="d"
     range 0 min=1/1 max=2/1
echo wrong-kind
add bool b ok
fr_option_add -> invalid
fr_range_add -> invalid
