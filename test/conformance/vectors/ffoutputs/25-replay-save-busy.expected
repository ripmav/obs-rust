> reset
> output rb
> venc h264 bitrate=2500 extra=0a0b
> set str directory /rec
> set str format r%N
> set str extension mp4
> knob defer_threads 1
> knob now_ns 1000
> create replay_buffer
proc_add "void save()"
proc_add "void get_last_replay(out string path)"
signal_add "void saved()"
signal_add "void saving(ptr output)"
