> reset
> output o
> venc h264 bitrate=2500 extra=0a0b
> aenc t0 aac 48000 1024 0 extra=cc
> set str path /v/first.mkv
> set bool split_file 1
> set int max_time_sec 1
> set str directory /rec
> set str format seg%N
> set str extension mkv
> create ffmpeg_muxer
signal_add "void file_changed(string next_file)"
proc_add "void split_file(out bool split_file_enabled)"
create ffmpeg_muxer -> ok
> start
unlink "/v/first.mkv"
pipe create type=w
  argv[0] "<bin>/obs-ffmpeg-mux"
  argv[1] "/v/first.mkv"
  argv[2] "1"
  argv[3] "1"
  argv[4] "h264"
  argv[5] "2500"
  argv[6] "1280"
  argv[7] "720"
  argv[8] "1"
  argv[9] "1"
  argv[10] "1"
  argv[11] "1"
  argv[12] "1"
  argv[13] "0"
  argv[14] "30"
