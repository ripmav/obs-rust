> reset
> output rb
> venc h264 bitrate=2500 extra=0a0b
> aenc t0 aac 48000 1024 0 extra=cc
> set str directory /rec
> set str format ties
> set str extension mp4
> create replay_buffer
proc_add "void save()"
proc_add "void get_last_replay(out string path)"
signal_add "void saved()"
signal_add "void saving(ptr output)"
create replay_buffer -> ok
> start
begin_data_capture
start -> 1
> pkt v pts=1000 dts=1000 key=1 size=1 sys=1
> pkt a pts=700 dts=700 size=1 sys=1
> pkt v pts=1040 dts=1040 key=0 size=1 sys=1
> pkt a pts=740 dts=740 size=1 sys=1
> pkt a pts=741 dts=741 size=1 sys=1
> knob now_ns 1000
> proc save
> pkt v pts=1080 dts=1080 key=0 size=1 sys=1
signal saving
mkdirs "/rec"
pipe create type=w
  argv[0] "<bin>/obs-ffmpeg-mux"
  argv[1] "/rec/ties.mp4"
