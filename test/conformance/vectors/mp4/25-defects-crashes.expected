echo --- D-8: AV1 packets with a truncated OBU header or a frame OBU of size 0 make the reference read 1-2 bytes past the packet.
echo --- Output of the packet itself is deterministic (the packet is stored without keyframe information from the garbage byte)
mux mp4 tracks=1
pkt v pts=0 dts=0 key=0 size=1 -> 1 pos=0
try pkt ok
