echo temporal-unit-with-sequence-header
av1_extract new=12000a0b00000024cf7f0d000c22c0320510aabbccdd header=0a0b00000024cf7f0d000c22c0
echo temporal-unit-without-headers
av1_extract new=120032052011223344 header=-
echo metadata-obus-count-as-headers
av1_extract new=12002a0301aabb320510aabbccdd2a0402aabbcc header=2a0301aabb2a0402aabbcc
echo other-obus-are-not-headers
av1_extract new=1200220200ff7a0300000032052011223344 header=-
echo header-order-is-input-order
av1_extract new=2a0301aabb0a0b00000024cf7f0d000c22c02a0402aabbcc0a0b00000024cf7f0d000c22c0 header=2a0301aabb0a0b00000024cf7f0d000c22c02a0402aabbcc0a0b00000024cf7f0d000c22c0
echo obus-without-size-field
av1_extract new=08 header=08
av1_extract new=08aabbcc header=08aabbcc
av1_extract new=10aabbcc header=-
av1_extract new=28aabb header=28aabb
echo obu-without-size-field-swallows-the-rest
av1_extract new=120008aabb32052011223344 header=08aabb32052011223344
echo empty-and-tiny-inputs
av1_extract new=- header=-
av1_extract new=12 header=-
av1_extract new=1200 header=-
av1_extract new=0a header=0a
av1_extract new=0a00 header=0a00
echo extension-flag
av1_extract new=0e0102aa header=0e0102aa
av1_extract new=0e0100 header=0e0100
av1_extract new=0e01001200 header=0e0100
av1_extract new=0e0102aa1200 header=0e0102aa12
echo multi-byte-obu-size
av1_extract  
echo trailing-zero-byte-is-a-padding-obu-of-type-0
av1_extract new=12003205201122334400 header=-
av1_extract new=12000000 header=-
