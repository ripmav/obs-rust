create c cut_transition
  ev transition_enable_fixed 1 duration_ms=0
  instance=1
  fields (none)
create f fade_transition
  ev enter_graphics
  ev effect_create file=@data/fade_transition.effect
  ev leave_graphics
  instance=1
  fields (none)
create x fade_to_color_transition
  ev enter_graphics
  ev effect_create file=@data/fade_to_color_transition.effect
  ev leave_graphics
  ev source_update x deferred (count 1)
  instance=1
  fields color=0,0,0,0 srgb=0,0,0,0 switch_point=0
create w wipe_transition
  ev enter_graphics
  ev effect_create file=@data/luma_wipe_transition.effect
  ev leave_graphics
  ev enter_graphics
  ev image_free loaded=0
  ev leave_graphics
  ev image_init file=@data/luma_wipes/linear-h.png alpha_mode=0
  ev   -> loaded 720x576 depth=8 color_type=0
  ev enter_graphics
  ev image_init_texture -> texture 301
  ev leave_graphics
  instance=1
  fields invert=0 softness=0.0299999993 luma_loaded=1 luma_size=720x576 luma_tex=1 wipes_list=1
create s slide_transition
  ev enter_graphics
  ev effect_create file=@data/slide_transition.effect
  ev leave_graphics
  ev source_update s deferred (count 1)
  instance=1
  fields dir=0,0
create p swipe_transition
  ev enter_graphics
  ev effect_create file=@data/swipe_transition.effect
  ev leave_graphics
  ev source_update p deferred (count 1)
  instance=1
  fields (uninitialised until the first update)
