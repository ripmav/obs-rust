start st
  ev proc_call media#2 get_duration
  ev proc_call media#2 get_nb_frames
  ev transition_enable_fixed 1 duration_ms=1250
  ev add_active_child st <- media#2
  fields tp_is_frame=0 tp_ns=0 tp_frame=0 tp=0.00100000005 a_mul=999.999939 b_mul=1.001001
  fields duration_ns=1250000000 duration_frames=60 transitioning=1 monitoring=0 fade_style=0
  fields matte_enabled=1 layout=0 wf=2 hf=1 invert=0 texrender=1 rendered=0 media=1 matte_src=0 mix_fn=fadeinout
  source media#1 name="st (Stinger)" id=ffmpeg_source refs=0 active_child_refs=0 muted=0 monitoring=0
  source media#2 name="st (Stinger)" id=ffmpeg_source refs=1 active_child_refs=1 muted=0 monitoring=0
render st
