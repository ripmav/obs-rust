echo no-video-info-matrix-ignored-max-video-bitrate-4000-applies
apply A forwarded=1
settings V
  bf = int 2
  bitrate = int 4000
  buffer_size = int 4000
  keyint_sec = int 3
  rate_control = "CBR"
  x264opts = "tune=zerolatency"
settings AU
  bitrate = int 128
echo below-limit-untouched
apply A forwarded=1
settings V
  bf = int 2
  bitrate = int 2000
  buffer_size = int 123
  keyint_sec = int 3
  profile = "high"
  rate_control = "CBR"
  x264opts = "ref=2 tune=zerolatency"
settings AU
  bitrate = int 96
echo profile-only-replaced-when-existing-item-is-a-string
