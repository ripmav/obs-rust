get url = "rtmps://fb1.example/rtmp/"
settings S
  key = "k"
  multitrack_video_disclaimer = "Multitrack Video automatically optimizes your stream settings, which may include encoding multiple video qualities and/or canvas orientations. Selecting this option will send Facebook Live X information about your computer and software setup."
  multitrack_video_name = "Multitrack Video"
  protocol = "RTMPS"
  server = "rtmps://fb1.example/rtmp/"
  service = "Facebook Live X"
echo known-server-kept-case-insensitive
get url = "RTMPS://FB2.EXAMPLE/rtmp/"
echo empty-server-string-is-replaced-too
get url = "rtmps://fb1.example/rtmp/"
echo other-service-keeps-unknown-server
get url = "rtmp://elsewhere/x"
echo alt-name-with-facebook-keeps-original-name-check
get url = "rtmp://x"
