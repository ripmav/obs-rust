fake proc_handler_add "void twitch_ingests_refresh(int seconds)"
fake proc_handler_add "void amazon_ivs_ingests_refresh(int seconds)"
fake update_info_create prefix="[rtmp-services plugin] " agent="rtmp-services plugin (libobs 99.0.0-test)" url=https://obsproject.com/obs2_update/rtmp-services/v5 local=/mod/data cache=/cfg/rtmp-services/ confirm=set
fake obs_register_service id=rtmp_common
fake obs_register_service id=rtmp_custom
module-load -> 1 name="rtmp-services plugin (libobs 99.0.0-test)"
props P
  prop service type=list desc="Service" visible=1 enabled=1 combo=2 format=3 items=5
    item 0 name="Alpha" value="Alpha" disabled=0
    item 1 name="Golf" value="Golf" disabled=0
    item 2 name="Facebook Live X" value="Facebook Live X" disabled=0
    item 3 name="Kilo" value="Kilo" disabled=0
    item 4 name="Twitch" value="Twitch" disabled=0
  prop show_all type=bool desc="Show all services" visible=1 enabled=1
  prop server type=list desc="Server" visible=1 enabled=1 combo=2 format=3 items=3
    item 0 name="Auto (Recommended)" value="auto" disabled=0
    item 1 name="Static A" value="rtmp://a.twitch.example/app" disabled=0
    item 2 name="Static B" value="rtmp://b.twitch.example/app" disabled=0
  prop key type=text desc="Stream key" visible=1 enabled=1 text_type=1
echo auto-url-waits-3s-then-returns-the-default-ingest
fake update_info_create_single prefix="[twitch ingest update] " agent="rtmp-services plugin (libobs 99.0.0-test)" url=https://ingest.twitch.tv/ingests
get url = "rtmp://ingest.global-contribute.live-video.net/app"
get key = "live_123"
clock 3000 ms
echo repeated-lookups-wait-again
get url = "rtmp://ingest.global-contribute.live-video.net/app"
clock 6000 ms
echo explicit-server-is-returned-as-is-without-waiting
get url = "rtmp://a.twitch.example/app"
clock 6000 ms
echo connect-info-and-can-connect
get connect:0 = "rtmp://ingest.global-contribute.live-video.net/app"
get can_connect = 1
clock 12000 ms
fake update_info_destroy url=https://obsproject.com/obs2_update/rtmp-services/v5 pending=0
fake update_info_destroy url=https://ingest.twitch.tv/ingests pending=0
module-unload
