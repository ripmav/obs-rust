signal hotkey_register id=0
reg A -> 0
signal hotkey_register id=1
reg B -> 1
load-combos
signal hotkey_bindings_changed id=0
signal hotkey_bindings_changed id=1
b 0 hk=0 mods=0x2 key=OBS_KEY_A pressed=0 modmatch=0 hkptr_ok=1
b 1 hk=0 mods=0x6 key=OBS_KEY_F1 pressed=0 modmatch=0 hkptr_ok=1
b 2 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
enumb done
save A count=2
  item {"shift":true,"key":"OBS_KEY_A"}
  item {"shift":true,"control":true,"key":"OBS_KEY_F1"}
save B count=1
  item {"key":"OBS_KEY_B"}
replace-A-moves-to-end-of-array
signal hotkey_bindings_changed id=0
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
b 1 hk=0 mods=0x8 key=OBS_KEY_C pressed=0 modmatch=0 hkptr_ok=1
enumb done
clear-with-combos-emits-signal-when-bindings-existed
signal hotkey_bindings_changed id=0
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
enumb done
clear-when-nothing-to-remove-no-signal
non-persisted-modifier-bits-and-all-four-persisted
signal hotkey_bindings_changed id=0
save A count=4
  item {"key":"OBS_KEY_D"}
  item {"key":"OBS_KEY_E"}
  item {"shift":true,"control":true,"alt":true,"command":true,"key":"OBS_KEY_F"}
  item {"shift":true,"control":true,"alt":true,"command":true,"key":"OBS_KEY_G"}
load-from-json
signal hotkey_bindings_changed id=0
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
b 1 hk=0 mods=0x2 key=OBS_KEY_H pressed=0 modmatch=0 hkptr_ok=1
b 2 hk=0 mods=0x8c key=OBS_KEY_I pressed=0 modmatch=0 hkptr_ok=1
enumb done
save A count=2
  item {"shift":true,"key":"OBS_KEY_H"}
  item {"control":true,"alt":true,"command":true,"key":"OBS_KEY_I"}
json-booleans-must-be-bool-false-ignored-unknown-key-name
signal hotkey_bindings_changed id=0
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
b 1 hk=0 mods=0x0 key=OBS_KEY_J pressed=0 modmatch=0 hkptr_ok=1
b 2 hk=0 mods=0x2 key=OBS_KEY_NONE pressed=0 modmatch=0 hkptr_ok=1
b 3 hk=0 mods=0x2 key=OBS_KEY_NONE pressed=0 modmatch=0 hkptr_ok=1
b 4 hk=0 mods=0x0 key=OBS_KEY_K pressed=0 modmatch=0 hkptr_ok=1
enumb done
save A count=4
  item {"key":"OBS_KEY_J"}
  item {"shift":true,"key":"OBS_KEY_NONE"}
  item {"shift":true,"key":"OBS_KEY_NONE"}
  item {"key":"OBS_KEY_K"}
load-empty-array-removes-but-emits-no-signal
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
enumb done
load-null-array-also-removes
signal hotkey_bindings_changed id=0
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
enumb done
load-on-unknown-id-ignored
save id:500 null
b 0 hk=1 mods=0x0 key=OBS_KEY_B pressed=0 modmatch=0 hkptr_ok=1
enumb done
