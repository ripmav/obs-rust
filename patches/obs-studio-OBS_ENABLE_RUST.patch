diff --git a/libobs/util/dstr-variadic-bridge.c b/libobs/util/dstr-variadic-bridge.c
new file mode 100644
index 0000000..b3687b1
--- /dev/null
+++ b/libobs/util/dstr-variadic-bridge.c
@@ -0,0 +1,77 @@
+// P1-02.4 (S-006): the four variadic dstr functions, which cannot be
+// defined in Rust (the `va_list` ABI). The C implementation of dstr.c
+// is kept verbatim here; they operate on the shared `struct dstr`
+// (the dstr.h inlines drive the layout the Rust `Dstr` mirrors, the
+// darray/deque precedent).
+//
+// Only swap builds compile this file: the conformance swap runner adds
+// it when it links the Rust staticlib (run.sh; dstr.c itself is then
+// dropped), and the OBS_ENABLE_RUST CMake build compiles it into
+// libobs (the patch adds it to libobs/util/). Check builds compile
+// dstr.c and never see this file.
+
+#include "util/dstr.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+void dstr_vprintf(struct dstr *dst, const char *format, va_list args)
+{
+	va_list args_cp;
+	va_copy(args_cp, args);
+
+	int len = vsnprintf(NULL, 0, format, args_cp);
+	va_end(args_cp);
+
+	if (len < 0)
+		len = 4095;
+
+	dstr_ensure_capacity(dst, ((size_t)len) + 1);
+	len = vsnprintf(dst->array, ((size_t)len) + 1, format, args);
+
+	if (!*dst->array) {
+		dstr_free(dst);
+		return;
+	}
+
+	dst->len = len < 0 ? strlen(dst->array) : (size_t)len;
+}
+
+void dstr_printf(struct dstr *dst, const char *format, ...)
+{
+	va_list args;
+	va_start(args, format);
+	dstr_vprintf(dst, format, args);
+	va_end(args);
+}
+
+void dstr_vcatf(struct dstr *dst, const char *format, va_list args)
+{
+	va_list args_cp;
+	va_copy(args_cp, args);
+
+	int len = vsnprintf(NULL, 0, format, args_cp);
+	va_end(args_cp);
+
+	if (len < 0)
+		len = 4095;
+
+	dstr_ensure_capacity(dst, dst->len + ((size_t)len) + 1);
+	len = vsnprintf(dst->array + dst->len, ((size_t)len) + 1, format, args);
+
+	if (!*dst->array) {
+		dstr_free(dst);
+		return;
+	}
+
+	dst->len += len < 0 ? strlen(dst->array + dst->len) : (size_t)len;
+}
+
+void dstr_catf(struct dstr *dst, const char *format, ...)
+{
+	va_list args;
+	va_start(args, format);
+	dstr_vcatf(dst, format, args);
+	va_end(args);
+}
diff --git a/libobs/util/srcprof-bridge.c b/libobs/util/srcprof-bridge.c
new file mode 100644
index 0000000..f85758f
--- /dev/null
+++ b/libobs/util/srcprof-bridge.c
@@ -0,0 +1,33 @@
+// P1-12.3 (S-055 U3): the source profiler's graphics context for the Rust
+// bridge (crates/obs-ffi/src/abi_source_profiler.rs).
+//
+// The C reference enters the context with `obs->video.graphics`
+// (source-profiler.c); the layout is computed from the real libobs
+// headers here, so the Rust side carries no mirror. Not compiled by the
+// cargo build.rs (libobs is a gitignored symlink, absent on CI) — the
+// swap conformance runner compiles it as a runner source (run.sh), and
+// the OBS_ENABLE_RUST CMake build compiles it into libobs (the patch
+// adds it to libobs/util/); the c-swap test build links the no-op
+// stand-ins from the crate's test module instead.
+//
+// The `obs` guard: the C reference assumes a live core; a NULL core is
+// UB there, the port skips the (contextually inert) enter/leave instead.
+// The conformance runner and production libobs always provide a live
+// `obs`, so the counts match the reference exactly.
+
+#include "obs-internal.h"
+#include "graphics/graphics.h"
+
+void obs_ffi_srcprof_enter_context(void)
+{
+	if (!obs)
+		return;
+	gs_enter_context(obs->video.graphics);
+}
+
+void obs_ffi_srcprof_leave_context(void)
+{
+	if (!obs)
+		return;
+	gs_leave_context();
+}
