@@ -77,7 +77,12 @@ else()
 endif()
 
 if(TARGET gio::gio)
-  target_sources(libobs PRIVATE util/platform-nix-dbus.c util/platform-nix-portal.c)
+  target_sources(
+    libobs
+    PRIVATE
+      $<$<NOT:$<BOOL:${OBS_ENABLE_RUST}>>:util/platform-nix-dbus.c>
