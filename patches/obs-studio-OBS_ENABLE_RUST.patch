     util/threading-posix.h
 )
 
@@ -72,7 +72,12 @@ else()
 endif()
 
 if(TARGET gio::gio)
-  target_sources(libobs PRIVATE util/platform-nix-dbus.c util/platform-nix-portal.c)
+  target_sources(
+    libobs
+    PRIVATE
+      $<$<NOT:$<BOOL:${OBS_ENABLE_RUST}>>:util/platform-nix-dbus.c>
+      $<$<NOT:$<BOOL:${OBS_ENABLE_RUST}>>:util/platform-nix-portal.c>
+  )
   target_link_libraries(libobs PRIVATE gio::gio)
 endif()
 
